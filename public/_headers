# Cabeceras de los assets estaticos servidos por Cloudflare Workers.
# Este archivo NO se sirve: Workers lo parsea y aplica las reglas.
#
# OJO: Cloudflare SUMA las cabeceras de todas las reglas que matchean, no las
# reemplaza. Por eso el catch-all /* NO define Cache-Control: si lo hiciera, se
# concatenaria con la de los assets inmutables y el navegador leeria el primer
# max-age=0, anulando el cache.
#
# El default de Cloudflare para HTML ya es max-age=0, must-revalidate, que es
# justo lo que queremos: el HTML no lleva hash y cambia en cada importacion.

# ---------------------------------------------------------------------------
# Assets con hash de contenido en el nombre: su URL cambia si cambia el
# contenido, asi que nunca hay que revalidarlos.
# ---------------------------------------------------------------------------
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Imagenes del catalogo. La clave incluye el SHA-256 del original (SPEC §5.1),
# asi que son inmutables por construccion.
#
# La ruta tiene tres niveles (/img-dev/catalogo/{hash}/w{n}.webp) y un splat
# simple no la alcanza, asi que se usa un placeholder para el hash.
/img-dev/catalogo/:hash/*
  Cache-Control: public, max-age=31536000, immutable

# ---------------------------------------------------------------------------
# Cabeceras de seguridad para todo. Sin Cache-Control, ver nota de arriba.
# ---------------------------------------------------------------------------
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
