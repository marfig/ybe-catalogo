{
  // Worker de admin: SSR con bindings de lectura y escritura (SPEC-etapa2 §4.1).
  //
  // Es el UNICO Worker con bindings. El del sitio publico (wrangler.jsonc de la
  // raiz) no tiene ninguno a proposito: no puede leer ni escribir D1 ni R2 ni por
  // un import mal puesto.
  //
  // Protegido por Cloudflare Access (§6). La politica se configura en el panel,
  // pero el Worker NO confia en eso: valida el JWT en cada request
  // (src/middleware.ts). Access delante es la puerta; la validacion es la cerradura.
  "name": "ybe-admin",
  "compatibility_date": "2026-07-31",

  // El adapter de Astro necesita las APIs de Node en el runtime de Workers.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ybe-catalogo",
      "database_id": "693387a5-f13b-4514-ad49-56a6bd5621ef"
      // Sin migrations_dir: las migraciones se operan desde db/wrangler.jsonc.
      // Que el Worker de admin pudiera aplicar migraciones no aporta nada y
      // agranda lo que un bug en el admin puede romper.
    }
  ],

  "r2_buckets": [
    {
      "binding": "IMAGENES",
      "bucket_name": "ybe-catalogo"
    }
  ],

  // Almacen de sesiones de Astro. NO lo usa ningun codigo nuestro —la identidad sale
  // del JWT de Access en cada request (§6), no de una sesion— pero el adapter de
  // Cloudflare lo exige y el primer `wrangler deploy` lo provisiono solo.
  //
  // VA DECLARADO ACA, aunque funcione sin declararlo: sin esto el id vive unicamente
  // en la cuenta de Cloudflare, y un deploy desde otra maquina o cuenta provisionaria
  // un namespace NUEVO sin que nadie se entere de por que hay dos.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "b66757af26a34154addb37507a775641"
    }
  ],

  // GITHUB_TOKEN va como SECRET, no aca:
  //   npx wrangler secret put GITHUB_TOKEN -c admin/wrangler.jsonc
  // Un token con contents:write en vars quedaria en texto plano en el repo.
  "vars": {
    // CF_ACCESS_TEAM: nombre del equipo de Zero Trust (o su dominio completo).
    // CF_ACCESS_AUD: el AUD tag de la aplicacion de Access del admin.
    //
    // No son secretos — el AUD tag identifica la aplicacion, no autoriza nada — asi
    // que van como vars y no como secrets. Se completan al crear la aplicacion en
    // el panel; el middleware falla con la lista de lo que falta.
    "CF_ACCESS_TEAM": "old-forest-3a66",
    "CF_ACCESS_AUD": "028ec25913a6173ae48c311281caf62e923f38f09977eb490c104e7a4ad6222b",

    // Base publica del bucket R2, para las miniaturas de la grilla. Es la misma
    // que usa el sitio publico; el admin no necesita leer R2 por binding para
    // mostrar una foto que ya es publica.
    "PUBLIC_R2_BASE": "https://img.asuncionybe.com",

    // Repositorio al que se manda el repository_dispatch al publicar (§11.2).
    "GITHUB_REPO": "marfig/ybe-catalogo"
  },

  // Registro de invocaciones.
  //
  // ENTRO POR UN INCIDENTE QUE NO DEJO RASTRO. El 2026-08-19 el admin estuvo muy
  // lento durante una tarde de carga —una migracion masiva y otra persona curando
  // en la grilla al mismo tiempo— y horas despues ya estaba sano. Diagnosticarlo
  // fue reconstruirlo de memoria: no habia ni una duracion registrada, y las
  // mediciones que si se podian hacer eran en calma, o sea sobre el escenario que
  // no fallaba. El inicio paso de 17 s a 526 ms sin cambiar una linea de codigo.
  //
  // Con esto, la proxima vez hay numeros en vez de una sensacion: duracion por
  // request y cada subpedido que hace el Worker, que es justo donde aparecen los
  // viajes a D1.
  "observability": {
    "enabled": true
  }
}
