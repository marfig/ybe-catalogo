---
/**
 * Grilla de productos: la pantalla principal del admin (SPEC-etapa2 §10.3).
 *
 * Busqueda y filtro van por GET, sin JavaScript. Tres razones: la URL queda
 * compartible y recargable, el botón de atrás funciona, y una pantalla de trabajo no
 * puede depender de que un bundle cargue.
 */
import { env } from 'cloudflare:workers';

import Panel from '../layouts/Panel.astro';
import { validarParaAprobar } from '../lib/aprobacion.ts';
import { CATEGORIAS, SLUGS_VALIDOS, nombreCategoria } from '../lib/categorias.ts';
import { ejecutorD1 } from '../lib/d1.ts';
import {
  FILTROS,
  FILTRO_POR_DEFECTO,
  contarPorEstado,
  listarProductos,
  type ValorFiltro,
} from '../lib/grilla.ts';
import { aprobar, asignarCategorias, type ResultadoItem } from '../lib/transiciones.ts';

const ejecutar = ejecutorD1(env.DB);

/**
 * POST → acción en lote → redirect (303) al mismo listado.
 *
 * Se redirige en vez de renderizar el resultado directo para que recargar no vuelva a
 * enviar el formulario. Las dos operaciones son idempotentes, así que un reenvío no
 * rompe nada — pero un F5 que "aprueba de nuevo" igual asusta y ensucia el reporte.
 *
 * El resumen viaja en la query porque el admin no tiene sesión donde dejar un mensaje
 * (ver la nota de sesiones en astro.config.mjs).
 */
if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const ids = datos.getAll('id').map((v) => Number(v)).filter(Number.isInteger);
  const accion = datos.get('accion');

  const destino = new URL(Astro.url);
  destino.search = new URLSearchParams({
    ...Object.fromEntries(Astro.url.searchParams),
  }).toString();

  const resumir = (rs: ResultadoItem[]) => {
    const fallidos = rs.filter((r) => !r.ok);
    destino.searchParams.set('hechos', String(rs.length - fallidos.length));
    if (fallidos.length > 0) {
      // Se mandan pocos: el detalle completo vuelve a estar en la grilla, que ya
      // muestra qué le falta a cada producto.
      destino.searchParams.set(
        'fallaron',
        fallidos
          .slice(0, 5)
          .map((r) => r.codigo ?? r.id)
          .join(',')
      );
      destino.searchParams.set('fallidos', String(fallidos.length));
    }
  };

  try {
    if (ids.length === 0) {
      destino.searchParams.set('error', 'No se seleccionó ningún producto.');
    } else if (accion === 'aprobar') {
      resumir(
        await aprobar(ejecutar, ids, {
          categoriasValidas: SLUGS_VALIDOS,
          ahora: new Date().toISOString(),
          permitirSinFoto: datos.get('sin-foto') === 'si',
        })
      );
    } else if (accion === 'categorias') {
      resumir(
        await asignarCategorias(
          ejecutar,
          ids,
          datos.getAll('categoria').map(String),
          { categoriasValidas: SLUGS_VALIDOS, ahora: new Date().toISOString() }
        )
      );
    } else {
      destino.searchParams.set('error', 'Acción desconocida.');
    }
  } catch (error) {
    // `asignarCategorias` lanza ante una entrada inválida en vez de aplicar a medias.
    destino.searchParams.set('error', error instanceof Error ? error.message : String(error));
  }

  return Astro.redirect(destino.toString(), 303);
}

const parametros = Astro.url.searchParams;
const busqueda = parametros.get('q') ?? '';

/**
 * Un `estado` desconocido en la URL cae al default en vez de reventar.
 *
 * `listarProductos` SI revienta ante un filtro invalido — eso protege de mostrar la
 * papelera por accidente — pero un parametro tipeado a mano en la barra no deberia
 * dar un error: se corrige y se sigue.
 */
const pedido = parametros.get('estado');
const estado: ValorFiltro = FILTROS.some((f) => f.valor === pedido)
  ? (pedido as ValorFiltro)
  : FILTRO_POR_DEFECTO;

const POR_PAGINA = 50;
const pagina = Math.max(1, Number.parseInt(parametros.get('pagina') ?? '1', 10) || 1);

const [productos, conteo] = await Promise.all([
  listarProductos(ejecutar, {
    estado,
    busqueda,
    limite: POR_PAGINA,
    desplazamiento: (pagina - 1) * POR_PAGINA,
  }),
  contarPorEstado(ejecutar, busqueda),
]);

/** Cuantos hay en el filtro actual, para el paginado. */
const totalDelFiltro =
  estado === 'todos'
    ? conteo.importado + conteo.aprobado + conteo.publicado
    : conteo[FILTROS.find((f) => f.valor === estado)!.estado as keyof typeof conteo];

const hayMas = pagina * POR_PAGINA < totalDelFiltro;

/** Conserva los parametros vigentes al armar un enlace. */
function enlace(cambios: Record<string, string | number | null>): string {
  const p = new URLSearchParams(parametros);
  for (const [clave, valor] of Object.entries(cambios)) {
    if (valor === null || valor === '') p.delete(clave);
    else p.set(clave, String(valor));
  }
  const cadena = p.toString();
  return cadena === '' ? Astro.url.pathname : `${Astro.url.pathname}?${cadena}`;
}

const guaranies = new Intl.NumberFormat('es-PY');

/**
 * Se evalua la aprobacion de CADA fila, tambien de las ya aprobadas o publicadas.
 *
 * No es trabajo perdido: un producto publicado puede haber quedado invalido porque
 * se renombro una categoria en `categorias.json`, y la grilla es donde eso se tiene
 * que ver. Mostrarlo solo para los importados esconderia el problema justo en los
 * productos que estan en la calle.
 */
const filas = productos.map((p) => ({
  ...p,
  validacion: validarParaAprobar(
    {
      codigo: p.codigo,
      nombre: p.nombre,
      precio: p.precio,
      categorias: p.categorias,
      // La grilla no trae las variantes una por una: solo cuantas hay y cuantas
      // fotos en total. Alcanza para las reglas de §5.2, que preguntan si existe al
      // menos una variante y al menos una foto.
      variantes: p.variantes === 0 ? [] : [{ sku: p.codigo, color: '', imagenes: p.imagenes }],
    },
    { categoriasValidas: SLUGS_VALIDOS }
  ),
}));

const R2 = env.PUBLIC_R2_BASE;

/** Resumen de la acción anterior, que llegó por la query tras el redirect. */
const hechos = Number(parametros.get('hechos') ?? '0');
const fallidos = Number(parametros.get('fallidos') ?? '0');
const fallaron = parametros.get('fallaron') ?? '';
const errorAccion = parametros.get('error');
const hayResumen = errorAccion !== null || hechos > 0 || fallidos > 0;

/**
 * La URL a la que vuelve el POST: la misma vista, SIN el resumen anterior.
 *
 * Sin limpiarlo, el resumen viejo se sumaría al nuevo y quedaría una pantalla que
 * dice dos cosas distintas sobre lo mismo.
 */
const accion = (() => {
  const u = new URL(Astro.url);
  for (const clave of ['hechos', 'fallidos', 'fallaron', 'error']) u.searchParams.delete(clave);
  return `${u.pathname}${u.search}`;
})();
---

<Panel titulo="Productos">
  <form method="get" action={Astro.url.pathname} role="search" class="filtros">
    <p class="campo">
      <label for="q">Buscar por código o nombre</label>
      <input id="q" name="q" type="search" value={busqueda} placeholder="CG85527" />
    </p>
    <p class="campo">
      <label for="estado">Estado</label>
      <select id="estado" name="estado">
        {
          FILTROS.map((f) => (
            <option value={f.valor} selected={f.valor === estado}>
              {f.etiqueta}
              {f.estado ? ` (${conteo[f.estado as keyof typeof conteo]})` : ''}
            </option>
          ))
        }
      </select>
    </p>
    {/* El paginado se reinicia al filtrar porque el form no lo reenvia: quedar en la
        pagina 3 de un resultado de 1 pagina muestra una lista vacia que parece un
        error. */}
    <p class="campo" style="flex: 0 0 auto;">
      <button type="submit">Filtrar</button>
    </p>
  </form>

  {
    hayResumen ? (
      <p class={errorAccion ? 'resumen resumen--error' : 'resumen'} role="status">
        {errorAccion ? (
          errorAccion
        ) : (
          <>
            {hechos} {hechos === 1 ? 'producto actualizado' : 'productos actualizados'}
            {fallidos > 0 ? (
              <>
                {' · '}
                {fallidos} sin cambios
                {fallaron !== '' ? <> ({fallaron}{fallidos > 5 ? '…' : ''})</> : null}
              </>
            ) : null}
          </>
        )}
      </p>
    ) : null
  }

  {
    filas.length === 0 ? (
      <p class="vacio">
        No hay productos
        {busqueda !== '' ? (
          <>
            {' '}
            que coincidan con <strong>{busqueda}</strong>
          </>
        ) : null}{' '}
        en este filtro.
      </p>
    ) : (
      <form method="post" action={accion}>
        {/* Las acciones van ARRIBA de la lista: con 50 filas, un botón al pie obliga
            a scrollear hasta el fondo después de elegir. */}
        <fieldset class="lote">
          <legend>Acciones en lote</legend>

          <p class="lote-fila">
            <button type="submit" name="accion" value="aprobar">
              Aprobar seleccionados
            </button>
            <label class="lote-check">
              <input type="checkbox" name="sin-foto" value="si" />
              publicar sin foto
            </label>
          </p>

          <p class="lote-fila">
            <label for="categoria">Agregar categoría</label>
            <select id="categoria" name="categoria">
              {CATEGORIAS.map((c) => (
                <option value={c.id}>{c.nombre}</option>
              ))}
            </select>
            <button type="submit" name="accion" value="categorias">
              Asignar
            </button>
          </p>

          <p class="nota">
            Agregar una categoría no reemplaza las que el producto ya tiene, y la
            primera define la navegación.
          </p>
        </fieldset>

        <ul class="productos">
          {filas.map((p) => (
            <li class="producto">
              <label class="elegir">
                <input type="checkbox" name="id" value={String(p.id)} />
                <span class="oculto">Seleccionar {p.codigo}</span>
              </label>

              {p.miniatura ? (
                <img
                  src={`${R2}/catalogo/${p.miniatura}/w300.webp`}
                  alt=""
                  width="80"
                  height="80"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                /* Sin foto va un hueco rotulado, no una imagen rota: el mismo
                   criterio que el placeholder del sitio (SPEC.md §5.4). */
                <span class="sin-foto" role="img" aria-label="Producto sin imagen">
                  sin foto
                </span>
              )}

              <div class="datos">
                <p class="titulo">
                  <strong class="codigo">{p.codigo}</strong>
                  {p.nombre && p.nombre !== p.codigo ? <> · {p.nombre}</> : null}
                  {' · '}
                  {p.precio !== null ? `Gs. ${guaranies.format(p.precio)}` : 'Consultar precio'}
                </p>

                <p class="meta">
                  {p.variantes} {p.variantes === 1 ? 'color' : 'colores'} · {p.imagenes}{' '}
                  {p.imagenes === 1 ? 'foto' : 'fotos'}
                  {p.categorias.length > 0 ? (
                    <> · {p.categorias.map((c) => nombreCategoria(c)).join(', ')}</>
                  ) : null}
                </p>

                {p.categoria_origen ? <p class="origen">Origen: {p.categoria_origen}</p> : null}

                {p.validacion.puede ? (
                  <p class="estado estado--ok">✓ listo para aprobar</p>
                ) : (
                  <p class="estado estado--falta">⚠ {p.validacion.faltantes.join(', ')}</p>
                )}

                {p.validacion.avisos.length > 0 ? (
                  <p class="avisos">{p.validacion.avisos.join(' · ')}</p>
                ) : null}
              </div>
            </li>
          ))}
        </ul>
      </form>
    )
  }

  <nav class="paginado" aria-label="Paginado">
    {pagina > 1 ? <a href={enlace({ pagina: pagina - 1 })} rel="prev">← Anterior</a> : null}
    {totalDelFiltro > POR_PAGINA ? <span>Página {pagina}</span> : null}
    {hayMas ? <a href={enlace({ pagina: pagina + 1 })} rel="next">Siguiente →</a> : null}
  </nav>
</Panel>
