---
/**
 * Inicio del admin (SPEC-etapa2 §10.1).
 *
 * El estado del catálogo de un vistazo, el estado de la última publicación (§11.3) y
 * las dos puertas de entrada. «Listos para publicar» es el llamador a la acción: hay
 * trabajo terminado que todavía no está en el sitio.
 *
 * Acá vive el botón de publicar, y no en la grilla, porque publicar es una acción de
 * lote sobre TODO el catálogo (§11.2) — no sobre lo que esté filtrado en pantalla.
 * Ponerlo entre las acciones de la grilla haría pensar que publica lo seleccionado.
 */
import { env } from 'cloudflare:workers';

import Panel from '../layouts/Panel.astro';
import { ejecutorD1 } from '../lib/d1.ts';
import { despacharPublicacion, leerConfigDespacho } from '../lib/despacho.ts';
import { contarPorEstado, ESTADOS_LEGIBLES } from '../lib/grilla.ts';
import {
  cambiosSinPublicar,
  crearPublicacion,
  describirPublicacion,
  hayPublicacionEnCurso,
  ultimaPublicacion,
} from '../lib/publicaciones.ts';

const ejecutar = ejecutorD1(env.DB);

if (Astro.request.method === 'POST') {
  const destino = new URL(Astro.url);
  destino.search = '';
  const ahora = new Date().toISOString();

  try {
    /**
     * Se corta ANTES de crear la fila.
     *
     * El workflow ya colapsa builds con `concurrency` (§11.2); esto es la mitad de
     * arriba: sin este chequeo, cinco clicks nerviosos dejan cinco filas en
     * `publicaciones` y el admin muestra un estado que no corresponde a ningún run.
     */
    if (await hayPublicacionEnCurso(ejecutar, ahora)) {
      destino.searchParams.set('aviso', 'Ya hay una publicación en curso.');
    } else {
      const config = leerConfigDespacho(env as unknown as Record<string, string | undefined>);
      // La fila se crea PRIMERO: si el dispatch falla, queda registro del intento y
      // se marca como error, en vez de un botón que no hizo nada visible.
      const id = await crearPublicacion(ejecutar, { email: Astro.locals.identidad.email, ahora });
      try {
        await despacharPublicacion(config, id);
        destino.searchParams.set('aviso', 'Publicación pedida.');
      } catch (error) {
        await ejecutar(
          `UPDATE publicaciones SET estado = 'error', terminada_en = ?, error = ? WHERE id = ?`,
          [new Date().toISOString(), error instanceof Error ? error.message : String(error), id]
        );
        throw error;
      }
    }
  } catch (error) {
    destino.searchParams.set('error', error instanceof Error ? error.message : String(error));
  }

  return Astro.redirect(destino.toString(), 303);
}

const ahora = new Date().toISOString();
const [conteo, ultima, pendientes] = await Promise.all([
  contarPorEstado(ejecutar),
  ultimaPublicacion(ejecutar),
  cambiosSinPublicar(ejecutar),
]);
const publicacion = describirPublicacion(ultima, ahora);
const enCurso = await hayPublicacionEnCurso(ejecutar, ahora);

const aviso = Astro.url.searchParams.get('aviso');
const errorAccion = Astro.url.searchParams.get('error');

/**
 * Los cuatro contadores, en el orden del recorrido: entra, se aprueba, se publica.
 *
 * La papelera va a su PANTALLA (§10.5) y no al filtro de la grilla: es lo único que se
 * mira para deshacer algo, y ahí están restaurar y vaciar, que la grilla no tiene.
 */
const tarjetas = [
  { clave: 'importado', destino: '/productos?estado=por-aprobar', n: conteo.importado },
  { clave: 'aprobado', destino: '/productos?estado=aprobado', n: conteo.aprobado },
  { clave: 'publicado', destino: '/productos?estado=publicado', n: conteo.publicado },
  { clave: 'eliminado', destino: '/eliminados', n: conteo.eliminado },
] as const;
---

{/* Sólo mientras publica. El estado cambia en otra máquina —la Action reporta por la
    base (§11.3)— así que es el único momento en que esta pantalla envejece sola. */}
<Panel titulo="Catálogo" refrescarCada={enCurso ? 10 : undefined}>
  {
    errorAccion ? (
      <p class="resumen resumen--error" role="status">{errorAccion}</p>
    ) : aviso ? (
      <p class="resumen" role="status">{aviso}</p>
    ) : null
  }

  {
    /**
     * El aviso de bajas va ARRIBA de los contadores y no como una quinta tarjeta.
     *
     * No es un estado —se cruza con «En el catálogo», así que una tarjeta más haría que
     * los números no cierren— y además es trabajo que llegó de afuera: nadie lo provocó
     * y nadie lo va a buscar. Un contador entre otros cuatro se lee de reojo; esto pide
     * una decisión.
     */
    conteo.dadosDeBaja > 0 ? (
      <p class="resumen resumen--error" role="status">
        {conteo.dadosDeBaja === 1
          ? 'Hay 1 producto que el proveedor ya no publica.'
          : `Hay ${conteo.dadosDeBaja} productos que el proveedor ya no publica.`}{' '}
        {/* Al lugar donde se decide, no a una lista para mirar: el barrido no borró nada. */}
        <a href="/productos?estado=dados-de-baja">Revisarlos y decidir qué hacer</a>
      </p>
    ) : null
  }

  <ul class="tarjetas">
    {
      tarjetas.map((t) => (
        <li class={`tarjeta${t.clave === 'aprobado' && t.n > 0 ? ' tarjeta--llamador' : ''}`}>
          <a href={t.destino}>
            <strong>{t.n}</strong>
            <span>{ESTADOS_LEGIBLES[t.clave].etiqueta}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <section class={`publicacion publicacion--${publicacion.tono}`}>
    <h2>{publicacion.titulo}</h2>
    <p>{publicacion.detalle}</p>
    {
      ultima ? (
        <p class="nota">
          Pedida por {ultima.disparada_por}
          {/* El link al run es para el rol tecnico (§11.3): nunca es la explicacion
              de quien opera, por eso va al final y en letra chica. */}
          {publicacion.runUrl ? (
            <>
              {' · '}
              <a href={publicacion.runUrl} rel="noopener noreferrer" target="_blank">
                ver detalle técnico
              </a>
            </>
          ) : null}
        </p>
      ) : null
    }

    <form method="post" action="/">
      <button type="submit" disabled={enCurso}>
        {enCurso ? 'Publicando…' : 'Publicar cambios'}
      </button>
      {
        pendientes > 0 && !enCurso ? (
          <span class="nota nota--pendiente">
            {/* Cuenta TODO lo que cambio desde la ultima publicacion exitosa, no solo
                los aprobados. Editar un producto ya publicado no encendia ninguna
                señal: se guardaba y el Inicio se quedaba callado (§10.1). */}
            {pendientes === 1
              ? 'Hay 1 cambio sin publicar: el sitio todavía no lo muestra.'
              : `Hay ${pendientes} cambios sin publicar: el sitio todavía no los muestra.`}
          </span>
        ) : (
          <span class="nota">
            {/* Antes decia «con todo lo aprobado», y se leia como que el boton solo
                tocaba los aprobados. Tambien republica las ediciones de los que ya
                estaban y saca los eliminados. */}
            Publicar regenera el catálogo con el estado actual: los aprobados nuevos,
            las ediciones de los que ya estaban, y las bajas.
          </span>
        )
      }
    </form>
  </section>

  <nav class="puertas" aria-label="Cargar productos">
    <a class="puerta" href="/productos?estado=por-aprobar">
      <strong>Ver productos</strong>
      <span>Completar datos, aprobar y organizar por categoría.</span>
    </a>
    <a class="puerta" href="/importar">
      <strong>Importar desde el proveedor</strong>
      <span>Traer una tanda de lanzamientos con sus colores y sus fotos.</span>
    </a>
    <a class="puerta" href="/nuevo">
      <strong>Cargar un producto</strong>
      <span>Alta manual, con fotos desde el teléfono o la computadora.</span>
    </a>
    <a class="puerta" href="/barrido">
      <strong>Revisar bajas del proveedor</strong>
      <span>Preguntarle al proveedor qué de lo que tenemos ya no publica.</span>
    </a>
    <a class="puerta" href="/fotos-faltantes">
      <strong>Recuperar fotos que faltan</strong>
      <span>Buscar los productos que quedaron sin ninguna foto y pedírselas de nuevo.</span>
    </a>
  </nav>
</Panel>
