---
/**
 * Lista de pedidos especiales (SPEC.md §4.5, SPEC-etapa2 §10.6).
 *
 * La lista ES la pantalla de trabajo: el orden y el borrado se resuelven acá, sin
 * abrir cada ficha. Es el mismo criterio de la grilla de productos (§10.3) — «trabajo
 * de minutos y no de horas» — y pesa igual con diez fichas: reordenar tres es abrir y
 * cerrar tres pantallas si el campo vive sólo en el formulario.
 *
 * Lo que SI necesita abrir la ficha es el nombre, la descripcion y la foto: son
 * campos largos que en una celda se truncan a algo inutil.
 *
 * UN SOLO `<form>` PARA TODA LA LISTA, con varios botones de submit que se distinguen
 * por `name="accion"`. Es el patron de `productos.astro` y lo que permite que esto
 * funcione sin JavaScript. Un formulario por fila seria imposible: los `<form>` no se
 * pueden anidar, asi que el campo de orden y el boton de borrar de una misma fila no
 * podrian convivir.
 */
import { env } from 'cloudflare:workers';

import Panel from '../layouts/Panel.astro';
import { ejecutorD1 } from '../lib/d1.ts';
import { baseDeImagenes, urlMiniatura } from '../lib/imagenes.ts';
import {
  eliminarPedidoEspecial,
  listarPedidosEspeciales,
  moverPedido,
} from '../lib/pedidos-especiales.ts';

const ejecutar = ejecutorD1(env.DB);

/**
 * De donde salen las miniaturas. En dev, del R2 LOCAL de miniflare via el endpoint
 * `/img-dev`; en produccion, del bucket publico.
 *
 * NO se arma con `PUBLIC_R2_BASE` a mano: en `astro dev` el binding `IMAGENES` es
 * local, asi que apuntar al bucket publico da 404 en todo lo recien subido — se
 * escribe en un lado y se lee del otro.
 */
const R2 = baseDeImagenes({ baseR2: env.PUBLIC_R2_BASE, dev: import.meta.env.DEV });

let error: string | null = null;
let hecho: string | null = Astro.url.searchParams.get('hecho');

/**
 * Las filas ANTES de operar. Hacen falta para resolver el POST: el formulario manda
 * `orden-{id}` por fila, y sin saber que ids se rindieron no hay a que aplicarlos.
 */
const pedidosPrevios = await listarPedidosEspeciales(ejecutar);

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const accion = String(datos.get('accion') ?? '');

  try {
    /**
     * El id viaja EN EL VALOR del boton (`eliminar-12`) y no en un campo aparte.
     *
     * Con un `<input type="hidden" name="id">` por fila, el POST mandaria los diez y
     * el servidor no tendria forma de saber cual boton se apreto. El valor del submit
     * es el unico dato del formulario que identifica al que se uso.
     */
    if (accion.startsWith('eliminar-')) {
      const id = Number(accion.slice('eliminar-'.length));
      const ficha = pedidosPrevios.find((p) => p.id === id);
      await eliminarPedidoEspecial(ejecutar, id);
      hecho = ficha
        ? `«${ficha.nombre}» eliminada. Cuando publiques, su enlace deja de abrir.`
        : 'Ficha eliminada.';
    } else if (accion.startsWith('subir-') || accion.startsWith('bajar-')) {
      const [direccion, crudo] = accion.split('-');
      await moverPedido(ejecutar, Number(crudo), direccion as 'subir' | 'bajar', {
        ahora: new Date().toISOString(),
      });
      /*
        SIN mensaje de confirmacion: el resultado del movimiento es la lista misma, que
        se rinde de nuevo con la ficha en su lugar nuevo. Un cartel que diga «se movio»
        arriba de una lista donde se ve que se movio es ruido, y ademas empuja las filas
        para abajo justo cuando se esta comparando posiciones.
      */
    }
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
  }
}

/**
 * Se relee DESPUES de operar: si un guardado falló, lo que se muestra tiene que ser el
 * estado real de la base y no lo que se intentó escribir. En un GET son dos consultas
 * a una tabla de diez filas — el costo es nada al lado de mostrar un dato mentiroso.
 */
const pedidos =
  Astro.request.method === 'POST' ? await listarPedidosEspeciales(ejecutar) : pedidosPrevios;

/** Primera linea de la descripcion: alcanza para reconocer la ficha en la lista. */
const adelanto = (descripcion: string) => descripcion.split('\n')[0] ?? '';
---

<Panel titulo="Pedidos especiales" volver="/">
  <section class="pe-intro">
    {/* Sin `<h1>` ni bajada: el titulo ya lo rinde el encabezado del panel, y lo que
        es esta seccion se entiende con ver la lista. */}
    {error ? <p class="resumen resumen--error" role="status">{error}</p> : null}
    {hecho ? <p class="resumen" role="status">{hecho}</p> : null}

    {/* El alta es la accion principal y va ARRIBA, donde la vista cae primero, no al
        final de una lista que puede tener diez filas. */}
    <p class="pie-guardar">
      <a class="boton-enlace" href="/pedidos-especiales/nuevo">Agregar ficha</a>
    </p>
  </section>

  <section>
    <h2>Fichas cargadas ({pedidos.length})</h2>

    {
      pedidos.length === 0 ? (
        <p class="nota">
          Todavía no cargaste ninguna. Las que cargues aparecen acá con su foto, y desde
          esta misma lista las ordenás, las editás o las eliminás.
        </p>
      ) : (
        <form method="post">
          <ul class="fichas">
            {pedidos.map((p, i) => (
              <li class="ficha">
                {/* El enlace cubre la foto y el nombre, que es donde se hace clic cuando
                    se quiere abrir algo. Los controles quedan afuera: un `<input>` o un
                    `<button>` no pueden vivir dentro de un `<a>`. */}
                <a class="ficha-fila" href={`/pedidos-especiales/${p.slug}`}>
                  <img
                    src={urlMiniatura(R2, p.hash16, 300)}
                    alt=""
                    width="56"
                    height="56"
                    loading="lazy"
                  />

                  <span class="ficha-datos">
                    <strong>{p.nombre}</strong>
                    {/* La primera linea de la descripcion y no el slug: al recorrer diez
                        fichas lo que se busca es cual es cual, y «Cantidad minima: 12
                        unidades» distingue mucho mas que la direccion. */}
                    <span class="nota">{adelanto(p.descripcion)}</span>
                  </span>
                </a>

                <div class="ficha-controles">
                  {/*
                    `disabled` en las puntas y no oculto: un boton que desaparece corre
                    a los de al lado, y despues de mover una ficha la flecha queda en
                    otro lugar del que se acaba de apretar.

                    `aria-label` porque la flecha sola no dice nada a un lector de
                    pantalla, y el nombre de la ficha es lo que distingue un boton de
                    los otros nueve iguales.
                  */}
                  <span class="ficha-mover">
                    <button
                      name="accion"
                      value={`subir-${p.id}`}
                      disabled={i === 0}
                      aria-label={`Subir ${p.nombre}`}
                      title="Subir"
                    >
                      ↑
                    </button>
                    <button
                      name="accion"
                      value={`bajar-${p.id}`}
                      disabled={i === pedidos.length - 1}
                      aria-label={`Bajar ${p.nombre}`}
                      title="Bajar"
                    >
                      ↓
                    </button>
                  </span>

                  {/*
                    `data-eliminar` lleva el nombre para que la confirmacion pueda
                    NOMBRAR la ficha. Un «¿estás seguro?» pelado es la advertencia que
                    todo el mundo aprendio a aceptar sin leer.
                  */}
                  <button
                    class="boton-fantasma"
                    name="accion"
                    value={`eliminar-${p.id}`}
                    data-eliminar={p.nombre}
                  >
                    Eliminar
                  </button>
                </div>
              </li>
            ))}
          </ul>

        </form>
      )
    }
  </section>

  {/*
    UN SOLO dialogo para toda la lista, no uno por fila: lo unico que cambia entre una
    ficha y otra es el nombre, y diez dialogos serian diez copias del mismo marcado
    esperando a que se abra uno.

    `<dialog>` nativo y no un div con `position: fixed`: trae gratis el foco atrapado
    adentro, el cierre con Escape, el backdrop y el rol de dialogo modal para lectores
    de pantalla. Reimplementar eso a mano se hace mal casi siempre.

    Se rinde SIEMPRE y cerrado —un `<dialog>` sin `open` no ocupa lugar ni se ve— para
    que el script no tenga que crear marcado.
  */}
  <dialog class="dialogo" data-dialogo-eliminar>
    <form method="dialog">
      <h2>¿Eliminar esta ficha?</h2>
      <p><strong data-nombre></strong></p>
      {/*
        SIN «404» NI «URL»: esto lo lee quien vende, no quien programa. Lo que tiene que
        entender es la consecuencia concreta —el enlace que mandó por WhatsApp deja de
        abrir—, y eso se dice con las palabras de su trabajo.
      */}
      <p class="nota">
        Esto no se puede deshacer. Si compartiste el enlace de esta ficha por WhatsApp,
        cuando publiques va a dejar de abrir.
      </p>
      <p class="dialogo-acciones">
        {/*
          CANCELAR PRIMERO y con `autofocus`: es la salida segura, y el `<dialog>` abre
          con el foco en el primer control. Quien apreta Enter sin leer cancela, que es
          lo que se quiere que pase.

          `value` de cada boton: `method="dialog"` lo deja en `dialog.returnValue`, que
          es como el script sabe cual se apreto sin escuchar dos clicks distintos.
        */}
        <button value="cancelar" autofocus>Cancelar</button>
        <button class="boton-fantasma" value="eliminar">Sí, eliminar</button>
      </p>
    </form>
  </dialog>
</Panel>

<script>
  /**
   * Confirmar antes de borrar, con el `<dialog>` de la pagina.
   *
   * NO `confirm()`: es una caja del navegador que no se puede estilar, que en algunos
   * navegadores trae el nombre del sitio adelante y que bloquea el hilo. Un `<dialog>`
   * se ve como el resto del panel y nombra la ficha con el mismo tipo de letra.
   *
   * El listener va en el `<form>` de la lista con delegacion y no uno por boton: la
   * lista se rinde entera en cada request, asi que no hay nada que reenganchar.
   *
   * SI EL SCRIPT NO CARGA el formulario sigue funcionando y borra sin preguntar. La
   * confirmacion es una red contra el clic errado, no el mecanismo del borrado.
   */
  const dialogo = document.querySelector<HTMLDialogElement>('[data-dialogo-eliminar]');
  const lista = document.querySelector<HTMLFormElement>('form:not([method="dialog"])');

  if (dialogo && lista) {
    /** El boton que disparo el dialogo. Se guarda para poder reenviarlo al confirmar. */
    let pedido: HTMLButtonElement | null = null;

    lista.addEventListener('click', (evento) => {
      const boton = (evento.target as HTMLElement)?.closest<HTMLButtonElement>('[data-eliminar]');
      if (!boton) return;

      // Se frena SIEMPRE: el envio lo decide el dialogo.
      evento.preventDefault();
      pedido = boton;

      const nombre = dialogo.querySelector('[data-nombre]');
      if (nombre) nombre.textContent = boton.dataset.eliminar ?? '';
      dialogo.showModal();
    });

    /**
     * `close` y no un `click` en el boton: lo dispara tambien Escape y el click en el
     * backdrop, asi que el estado se limpia por todos los caminos de salida y no solo
     * por el que se penso.
     */
    dialogo.addEventListener('close', () => {
      const boton = pedido;
      pedido = null;
      if (dialogo.returnValue !== 'eliminar' || !boton) return;

      /*
        `requestSubmit(boton)` y no `lista.submit()`: el segundo NO manda el `name` y el
        `value` del boton, que es justamente donde viaja que ficha se borra. Ademas
        `requestSubmit` no vuelve a disparar el click, asi que no hay bucle.
      */
      boton.form?.requestSubmit(boton);
    });
  }
</script>
