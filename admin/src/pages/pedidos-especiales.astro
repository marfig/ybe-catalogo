---
/**
 * Lista de pedidos especiales (SPEC.md §4.5, SPEC-etapa2 §10.6).
 *
 * SOLO LISTA. El alta y la edicion viven en sus propias pantallas: un formulario
 * plantado debajo de la lista compite con ella por la atencion, y con la lista vacia la
 * pantalla se lee como un formulario suelto — que es exactamente como se leyo la
 * primera version.
 *
 * Misma forma que productos, que tiene grilla (§10.3) y ficha (§10.4) separadas.
 */
import { env } from 'cloudflare:workers';

import Panel from '../layouts/Panel.astro';
import { ejecutorD1 } from '../lib/d1.ts';
import { baseDeImagenes, urlMiniatura } from '../lib/imagenes.ts';
import { listarPedidosEspeciales } from '../lib/pedidos-especiales.ts';

const pedidos = await listarPedidosEspeciales(ejecutorD1(env.DB));

/**
 * De donde salen las miniaturas. En dev, del R2 LOCAL de miniflare via el endpoint
 * `/img-dev`; en produccion, del bucket publico.
 *
 * NO se arma con `PUBLIC_R2_BASE` a mano: en `astro dev` el binding `IMAGENES` es
 * local, asi que apuntar al bucket publico da 404 en todo lo recien subido — se
 * escribe en un lado y se lee del otro. Es el bug que `baseDeImagenes` existe para no
 * repetir, y esta pantalla lo repitio igual por no usarla.
 */
const R2 = baseDeImagenes({ baseR2: env.PUBLIC_R2_BASE, dev: import.meta.env.DEV });

/** Lo que dejo la pantalla anterior, para confirmar que la accion se hizo. */
const hecho = Astro.url.searchParams.get('hecho');

/** Primera linea de la descripcion: alcanza para reconocer la ficha en la lista. */
const adelanto = (descripcion: string) => descripcion.split('\n')[0] ?? '';
---

<Panel titulo="Pedidos especiales" volver="/">
  <section class="pe-intro">
    <h1>Pedidos especiales</h1>
    <p class="nota">
      Los artículos que se venden por cantidad, con precio a convenir. No llevan precio ni
      colores: la descripción es todo lo que el cliente lee antes de escribir por WhatsApp.
    </p>

    {hecho ? <p class="resumen" role="status">{hecho}</p> : null}

    {/* El alta es la accion principal de esta pantalla y va ARRIBA, donde la vista cae
        primero, no al final de una lista que puede tener diez filas. */}
    <p class="pie-guardar">
      <a class="boton-enlace" href="/pedidos-especiales/nuevo">Agregar ficha</a>
    </p>
  </section>

  <section>
    <h2>Fichas cargadas ({pedidos.length})</h2>

    {
      pedidos.length === 0 ? (
        <p class="nota">
          Todavía no cargaste ninguna. Las que cargues aparecen acá, con su foto y su
          dirección, y desde esta misma lista entrás a editarlas o eliminarlas.
        </p>
      ) : (
        <ul class="fichas">
          {pedidos.map((p) => (
            <li class="ficha">
              <a class="ficha-fila" href={`/pedidos-especiales/${p.slug}`}>
                <img src={urlMiniatura(R2, p.hash16, 300)} alt="" width="56" height="56" loading="lazy" />

                <span class="ficha-datos">
                  <strong>{p.nombre}</strong>
                  {/* La primera linea de la descripcion y no el slug: al recorrer diez
                      fichas lo que se busca es cual es cual, y «Cantidad minima: 12
                      unidades» distingue mucho mas que la direccion. */}
                  <span class="nota">{adelanto(p.descripcion)}</span>
                  <span class="nota">orden {p.orden}</span>
                </span>

                {/* TODA LA FILA ES EL ENLACE, y este texto sólo dice a dónde lleva. Un
                    botón «Editar» al costado dejaría el resto de la fila muerto, que es
                    justo donde se hace clic cuando se quiere abrir algo. */}
                <span class="ficha-ir" aria-hidden="true">Editar →</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Panel>
