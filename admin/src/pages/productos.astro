---
/**
 * Grilla de productos: la pantalla principal del admin (SPEC-etapa2 §10.3).
 *
 * Es una TABLA EDITABLE, no una lista de solo lectura con un boton "Editar" por fila
 * como propone el mock del SPEC. El trabajo real es rellenar nombre, precio y
 * categoria — exactamente las validaciones de §5.2 — y editarlos en la propia lista
 * evita abrir y cerrar una ficha por producto. El mismo razonamiento con el que §10.3
 * justifica las categorias en lote ("trabajo de minutos y no de horas") pega mas
 * fuerte todavia en el nombre y el precio, que NO se pueden hacer en lote.
 *
 * `descripcion` y `destacado` tambien se editan aca, y este comentario decia lo
 * contrario. La objecion original era buena pero era al LUGAR, no a la idea: la
 * descripcion son 80-120 caracteres que en una CELDA se truncan a algo inutil o
 * revientan la altura de la fila, y una octava columna le sacaria ancho al nombre, que
 * es el campo que mas se tipea.
 *
 * Asi que no va en una celda. Cada producto es su propio `<tbody>` con DOS `<tr>`: la
 * fila de campos de siempre, y debajo una fila a todo lo ancho —`colspan`— con el
 * destacado y la descripcion dentro de un `<details>` plegado. La descripcion tiene el
 * ancho completo de la tabla cuando se abre, y cerrada no cuesta ni una linea.
 *
 * Un `<textarea>` dentro de un `<details>` cerrado IGUAL viaja en el POST: `details`
 * oculta, no deshabilita. Plegar no pierde nada de lo tipeado.
 *
 * Todo por formularios, sin JavaScript: un solo `<form>` para la pagina y un POST con
 * todas las filas. El guardado por fila serian 50 requests y obligaria a JS.
 */
import { env } from 'cloudflare:workers';

import Panel from '../layouts/Panel.astro';
import { ejecutarAccion, esAccion, necesitaSeleccion } from '../lib/acciones.ts';
import { validarParaAprobar } from '../lib/aprobacion.ts';
import { CATEGORIAS, SLUGS_VALIDOS, nombreCategoria } from '../lib/categorias.ts';
import { ejecutorD1 } from '../lib/d1.ts';
import type { CambioFila } from '../lib/guardar.ts';
import { baseDeImagenes, urlMiniatura } from '../lib/imagenes.ts';
import {
  ESTADOS_LEGIBLES,
  FILTROS,
  FILTRO_POR_DEFECTO,
  SIN_CATEGORIA,
  contarPorEstado,
  estadoLegible,
  listarProductos,
  type ValorFiltro,
} from '../lib/grilla.ts';
import { formatearPrecio, parsearPrecio } from '../lib/precio.ts';
import { haceCuanto } from '../lib/publicaciones.ts';
import type { Desenlace, ResultadoItem } from '../lib/transiciones.ts';

const ejecutar = ejecutorD1(env.DB);

/**
 * POST -> accion -> redirect 303 al mismo listado.
 *
 * Se redirige en vez de renderizar el resultado directo para que recargar no vuelva a
 * enviar el formulario. El resumen viaja en la query porque el admin no tiene sesion
 * donde dejar un mensaje (ver la nota de sesiones en astro.config.mjs).
 */
if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const accionPedida = datos.get('accion');
  const seleccionados = datos.getAll('id').map(Number).filter(Number.isInteger);

  const destino = new URL(Astro.url);

  /**
   * Tres desenlaces, no dos.
   *
   * `omitido` no es un fallo: es un producto que no era candidato — ya está en el
   * catálogo, o ya tenía esa categoría. Mezclarlo con los que sí fallaron alarma por
   * algo que no pasó y esconde lo único accionable. Es la incoherencia que se veía
   * al aprobar una fila publicada: la grilla la deja editar, y después parecía decir
   * que la edición no valía.
   *
   * `guardarFilas` usa `ok`/`cambio` en vez de `desenlace`: se traducen acá.
   */
  const resumir = (
    rs: Array<
      ResultadoItem | { ok: boolean; cambio?: boolean; codigo?: string; id: number; motivo?: string }
    >
  ) => {
    const desenlaceDe = (r: (typeof rs)[number]): Desenlace => {
      if ('desenlace' in r) return r.desenlace;
      if (!r.ok) return 'fallo';
      return r.cambio === false ? 'omitido' : 'hecho';
    };

    const porTipo = { hecho: [], omitido: [], fallo: [] } as Record<Desenlace, typeof rs>;
    for (const r of rs) porTipo[desenlaceDe(r)].push(r);

    destino.searchParams.set('hechos', String(porTipo.hecho.length));
    if (porTipo.omitido.length > 0) {
      destino.searchParams.set('omitidos', String(porTipo.omitido.length));
      if (porTipo.omitido[0].motivo) {
        destino.searchParams.set('omitidoMotivo', porTipo.omitido[0].motivo);
      }
    }
    if (porTipo.fallo.length > 0) {
      destino.searchParams.set('fallidos', String(porTipo.fallo.length));
      destino.searchParams.set(
        'fallaron',
        porTipo.fallo.slice(0, 5).map((r) => r.codigo ?? r.id).join(',')
      );
      // El motivo del primero: con 50 filas, un conteo pelado obliga a adivinar.
      if (porTipo.fallo[0].motivo) destino.searchParams.set('motivo', porTipo.fallo[0].motivo);
    }
  };

  try {
    if (!esAccion(accionPedida)) {
      destino.searchParams.set('error', 'Acción desconocida.');
    } else {
      /**
       * Se recorren los ids que la pagina rindio (`fila`), no la seleccion, y para las
       * TRES acciones.
       *
       * Guardar no necesita tildar nada —las casillas son solo para el lote— pero
       * aprobar y asignar categorias tampoco pueden ignorar lo tipeado: es el estado de
       * verdad de la pantalla. El orden lo impone `ejecutarAccion`; aca solo se parsea.
       */
      const cambios: CambioFila[] = [];
      for (const valor of datos.getAll('fila')) {
        const id = Number(valor);
        if (!Number.isInteger(id)) continue;
        cambios.push({
          id,
          nombre: String(datos.get(`nombre-${id}`) ?? ''),
          descripcion: String(datos.get(`descripcion-${id}`) ?? ''),
          precio: parsearPrecio(String(datos.get(`precio-${id}`) ?? '')),
          /**
           * ACA se traduce "no vino" a `false`, y este es el unico lugar donde se puede
           * hacer bien.
           *
           * Un checkbox sin tildar NO viaja en el POST. La ausencia sola es ambigua
           * —¿destildado, o la fila no se rindio?— y lo que la desambigua es que se
           * llego hasta aca recorriendo `fila`, que solo trae las filas que la pagina
           * rindio. Fila presente + casilla ausente = destildado, sin inputs ocultos.
           */
          destacado: datos.get(`destacado-${id}`) === 'si',
          categoriaPrincipal: (datos.get(`categoria-${id}`) as string) || null,
        });
      }
      resumir(
        await ejecutarAccion(
          ejecutar,
          {
            accion: accionPedida,
            cambios,
            seleccionados,
            secundarias: datos.getAll('secundaria').map(String),
            /**
             * SIEMPRE true: la falta de fotos ya no bloquea.
             *
             * Era una casilla que habia que tildar aparte, y la decision de quien opera
             * fue que aprobar es su responsabilidad. La validacion sigue existiendo en
             * `aprobacion.ts` —el aviso de "se publica sin foto" se emite igual— pero no
             * detiene a nadie: el sitio ya muestra el placeholder de "sin imagen".
             *
             * Va aca y no borrado de la libreria porque es una decision de ESTA pantalla.
             * La opcion sigue teniendo sus tests y otra pantalla puede querer lo contrario.
             */
            permitirSinFoto: true,
          },
          { categoriasValidas: SLUGS_VALIDOS, ahora: new Date().toISOString() }
        )
      );

      /**
       * El aviso de "no tildaste nada" va DESPUES de ejecutar, no antes.
       *
       * Antes cortaba la accion entera, asi que olvidarse de tildar —un error normal—
       * borraba tambien todo lo que se habia tipeado. Ahora lo tipeado ya se guardo y
       * esto es solo un aviso, por eso lo dice.
       */
      if (necesitaSeleccion(accionPedida) && seleccionados.length === 0) {
        destino.searchParams.set(
          'error',
          'No se seleccionó ningún producto, así que no se aprobó ni se categorizó nada. ' +
            'Lo que estaba escrito se guardó igual. Para aprobar sin tildar de a uno, ' +
            'usá «Aprobar los completos».'
        );
      }
    }
  } catch (error) {
    /**
     * `parsearPrecio` y `asignarCategorias` lanzan ante una entrada invalida, y las dos
     * cortan la accion entera. Pero ya no cortan lo mismo, y la diferencia importa:
     *
     *  - `parsearPrecio` corre ANTES de escribir, al armar `cambios`. Un precio mal
     *    tipeado no escribe NADA y el navegador conserva lo tipeado al volver atras. Si
     *    se guardaran las demas filas, la pagina se recargaria con el texto perdido y
     *    sin registro de cual era.
     *  - `asignarCategorias` corre DESPUES del guardado, asi que lo tipeado ya quedo
     *    escrito. Tambien es a proposito: una eleccion vacia en el desplegable del lote
     *    no tiene por que costarte el trabajo hecho en las filas. Las categorias, que
     *    son lo que fallo, no quedan a medias — eso lo garantiza `transiciones.ts`.
     */
    destino.searchParams.set('error', error instanceof Error ? error.message : String(error));
  }

  return Astro.redirect(destino.toString(), 303);
}

const parametros = Astro.url.searchParams;
const busqueda = parametros.get('q') ?? '';

/**
 * Categoria pedida. Una desconocida cae a "todas", igual que el estado.
 *
 * `SIN_CATEGORIA` es un valor valido y no un slug: son los que no tienen ninguna, que
 * es la cola de curaduria mas grande de esta pantalla.
 */
const categoriaPedida = parametros.get('categoria') ?? '';
const categoria =
  categoriaPedida === SIN_CATEGORIA || SLUGS_VALIDOS.has(categoriaPedida) ? categoriaPedida : '';

/** Para fechar el aviso de baja en cada fila. Una sola marca por render. */
const ahora = new Date().toISOString();

/**
 * Un `estado` desconocido en la URL cae al default en vez de reventar.
 *
 * `listarProductos` SI revienta ante un filtro invalido — eso protege de mostrar la
 * papelera por accidente — pero un parametro tipeado a mano en la barra no deberia
 * dar un error: se corrige y se sigue.
 */
const pedido = parametros.get('estado');
const estado: ValorFiltro = FILTROS.some((f) => f.valor === pedido)
  ? (pedido as ValorFiltro)
  : FILTRO_POR_DEFECTO;

const POR_PAGINA = 50;
const pagina = Math.max(1, Number.parseInt(parametros.get('pagina') ?? '1', 10) || 1);

const [productos, conteo] = await Promise.all([
  listarProductos(ejecutar, {
    estado,
    busqueda,
    categoria,
    limite: POR_PAGINA,
    desplazamiento: (pagina - 1) * POR_PAGINA,
  }),
  // Los mismos acotes que la lista: si no, los numeros del desplegable de estado
  // prometen filas que el filtro de categoria no va a mostrar.
  contarPorEstado(ejecutar, { busqueda, categoria }),
]);

/**
 * Cuantos productos tiene cada filtro. Alimenta el desplegable y el paginado.
 *
 * `dados-de-baja` sale de su propio contador y NO de la suma de estados: es un eje
 * transversal, asi que el mismo producto ya esta contado en `publicado`.
 */
function totalDe(valor: ValorFiltro): number {
  if (valor === 'dados-de-baja') return conteo.dadosDeBaja;
  if (valor === 'todos') return conteo.importado + conteo.aprobado + conteo.publicado;
  return conteo[FILTROS.find((f) => f.valor === valor)!.estado as keyof typeof conteo];
}

const totalDelFiltro = totalDe(estado);

const hayMas = pagina * POR_PAGINA < totalDelFiltro;

/** Conserva los parametros vigentes al armar un enlace. */
function enlace(cambios: Record<string, string | number | null>): string {
  const p = new URLSearchParams(parametros);
  for (const [clave, valor] of Object.entries(cambios)) {
    if (valor === null || valor === '') p.delete(clave);
    else p.set(clave, String(valor));
  }
  const cadena = p.toString();
  return cadena === '' ? Astro.url.pathname : `${Astro.url.pathname}?${cadena}`;
}

/**
 * Se evalua la aprobacion de CADA fila, tambien de las publicadas.
 *
 * Un producto en la calle puede haber quedado invalido porque se renombro una
 * categoria en `categorias.json`, y la grilla es donde eso se tiene que ver.
 */
const filas = productos.map((p) => ({
  ...p,
  validacion: validarParaAprobar(
    {
      codigo: p.codigo,
      nombre: p.nombre,
      precio: p.precio,
      categorias: p.categorias,
      variantes: p.variantes === 0 ? [] : [{ sku: p.codigo, color: '', imagenes: p.imagenes }],
    },
    // El MISMO criterio con el que aprueba el POST. Si acá la foto bloqueara y allá no,
    // la fila diría "⚠ sin fotos" y el botón la aprobaría igual: la insignia mentiría.
    { categoriasValidas: SLUGS_VALIDOS, permitirSinFoto: true }
  ),
}));

/**
 * Cuantos productos de esta pagina va a aprobar «Aprobar los completos».
 *
 * Se cuentan solo los `importado` que pasan la validacion, y NO todas las filas
 * completas: la grilla valida tambien las publicadas —a proposito, ver `filas`— y
 * contarlas prometeria aprobar productos que ya estan en la calle.
 *
 * Es ORIENTATIVO y no una promesa. Se calcula con lo que hay en la base al rendir la
 * pagina, y la accion guarda antes de aprobar: si se completan filas y despues se
 * aprieta el boton, van a entrar mas de las que dice este numero. La nota del boton lo
 * aclara, porque un contador que se queda corto sin explicacion se lee como un bug.
 */
const completosParaAprobar = filas.filter(
  (f) => f.estado === 'importado' && f.validacion.puede
).length;

/** Resumen de la accion anterior, que llego por la query tras el redirect. */
const hechos = Number(parametros.get('hechos') ?? '0');
const fallidos = Number(parametros.get('fallidos') ?? '0');
const fallaron = parametros.get('fallaron') ?? '';
const omitidos = Number(parametros.get('omitidos') ?? '0');
const omitidoMotivo = parametros.get('omitidoMotivo');
const motivo = parametros.get('motivo');
const errorAccion = parametros.get('error');
const hayResumen = errorAccion !== null || hechos > 0 || fallidos > 0 || omitidos > 0;

/** La URL a la que vuelve el POST: la misma vista, SIN el resumen anterior. */
const destinoPost = (() => {
  const u = new URL(Astro.url);
  for (const c of ['hechos', 'fallidos', 'fallaron', 'motivo', 'omitidos', 'omitidoMotivo', 'error']) u.searchParams.delete(c);
  return `${u.pathname}${u.search}`;
})();

/**
 * De dónde salen las miniaturas. En dev, del R2 local vía `/img-dev`; en producción,
 * del dominio público del bucket. La elección no se hace acá: es una sola decisión
 * compartida, y por eso vive en `lib/imagenes.ts` con sus tests.
 */
const R2 = baseDeImagenes({ baseR2: env.PUBLIC_R2_BASE, dev: import.meta.env.DEV });
---

<Panel titulo="Productos" volver="/">
  {/* El form de filtros va APARTE del de edicion: si fueran uno, filtrar mandaria
      tambien los campos editados y "Filtrar" se volveria un guardado encubierto. */}
  {/* EL ORDEN ES UN EMBUDO: estado, categoria, codigo.
      Los dos primeros ACOTAN un conjunto; el ultimo BUSCA uno puntual. Puestos asi se
      leen como una sola frase — "de los que estan por aprobar, de mochilas, el que
      diga CG85527" — y de paso se pasa por el filtro de estado antes de tipear el
      codigo, que es lo que evita buscar un publicado con el filtro en "Por aprobar" y
      creer que no existe. */}
  <form method="get" action={Astro.url.pathname} role="search" class="filtros">
    <p class="campo">
      <label for="estado">Estado</label>
      <select id="estado" name="estado">
        {
          FILTROS.map((f) => (
            <option value={f.valor} selected={f.valor === estado}>
              {f.etiqueta}
              {/* "Todos" sigue sin numero: es la suma de los de arriba y repetirla no
                  agrega nada. Las bajas SI lo llevan — es una cola de trabajo. */}
              {f.estado || f.valor === 'dados-de-baja' ? ` (${totalDe(f.valor)})` : ''}
            </option>
          ))
        }
      </select>
    </p>
    <p class="campo">
      <label for="categoria">Categoría</label>
      <select id="categoria" name="categoria">
        <option value="">Todas</option>
        {/* Va PRIMERO, arriba de las categorias reales, porque no es una de ellas: es la
            cola de trabajo. Un producto recien scrapeado nace sin categoria y sin
            categoria no se puede aprobar, asi que esta es la lista que hay que vaciar. */}
        <option value={SIN_CATEGORIA} selected={categoria === SIN_CATEGORIA}>
          — Sin categoría —
        </option>
        {CATEGORIAS.map((c) => (
          <option value={c.id} selected={categoria === c.id}>
            {c.nombre}
          </option>
        ))}
      </select>
    </p>
    <p class="campo">
      <label for="q">Buscar por código o nombre</label>
      <input id="q" name="q" type="search" value={busqueda} placeholder="CG85527" />
    </p>
    <p class="campo campo--boton"><button type="submit">Filtrar</button></p>
  </form>

  {/**
   * El recorrido sigue estando, pero ya no ocupa lugar: pasa de un bloque plegado en el
   * flujo a un `?` en la cabecera.
   *
   * El contenido es el MISMO y no un resumen. Es la maquina de estados de §5.2 contada
   * en el vocabulario de quien opera —los nombres crudos de la columna, `importado`,
   * `aprobado`, no le dicen nada a nadie— y eso no se puede recortar para que entre en
   * un globo.
   *
   * COSTO, dicho de frente: un `<dialog>` necesita JavaScript para abrirse. Es el unico
   * control de esta pantalla que no funciona sin el. Se acepta porque es AYUDA: sin JS
   * no se puede leer la leyenda, pero se puede trabajar igual. Ese mismo trato seria
   * inaceptable para un boton que escribe.
   */}
  <button type="button" class="ayuda-abrir" slot="junto-al-titulo" aria-haspopup="dialog"
    aria-label="¿Qué significa cada estado?" title="¿Qué significa cada estado?"
    data-abre="ayuda-estados">?</button>

  <dialog id="ayuda-estados" class="ayuda-modal" aria-labelledby="ayuda-titulo">
    <div class="ayuda-modal-cabecera">
      <h2 id="ayuda-titulo">¿Qué significa cada estado?</h2>
      {/* `formmethod="dialog"` no: este boton no esta en un form. Lo cierra el script,
          y ademas Escape lo cierra solo — eso lo da `<dialog>` nativo. */}
      <button type="button" class="ayuda-cerrar" data-cierra aria-label="Cerrar">×</button>
    </div>
    <ol class="recorrido">
      <li>
        <strong>{ESTADOS_LEGIBLES.importado.etiqueta}</strong>
        <span>{ESTADOS_LEGIBLES.importado.explicacion}</span>
        <em>Completá nombre, categoría y precio, y apretá «Aprobar».</em>
      </li>
      <li>
        <strong>{ESTADOS_LEGIBLES.aprobado.etiqueta}</strong>
        <span>{ESTADOS_LEGIBLES.aprobado.explicacion}</span>
        <em>Ya tiene su dirección web, que no cambia nunca más.</em>
      </li>
      <li>
        <strong>{ESTADOS_LEGIBLES.publicado.etiqueta}</strong>
        <span>{ESTADOS_LEGIBLES.publicado.explicacion}</span>
        <em>Podés seguir editando nombre y precio: la dirección no se mueve.</em>
      </li>
      <li>
        <strong>{ESTADOS_LEGIBLES.eliminado.etiqueta}</strong>
        <span>{ESTADOS_LEGIBLES.eliminado.explicacion}</span>
        <em>Quien tenga el enlace no encuentra un error, encuentra el catálogo.</em>
      </li>
    </ol>
    {/* Antes acá había un aviso de lo que faltaba: publicar, sacar de circulación y
        restaurar. Los tres existen desde hace varias fases y el texto quedó mintiendo.
        En su lugar va lo único que el recorrido deja sin contestar: la lista explica que
        «Listo para publicar» todavía no se ve en el sitio, y no dice dónde se publica. */}
    <p class="nota">
      Publicar no se hace desde esta pantalla: el botón está en el
      <a href="/">Inicio</a>, porque publicar es una acción del catálogo entero y no de
      un producto.
    </p>
  </dialog>

  {
    hayResumen ? (
      <p class={errorAccion ? 'resumen resumen--error' : 'resumen'} role="status">
        {errorAccion ? (
          errorAccion
        ) : (
          <>
            {hechos} {hechos === 1 ? 'producto actualizado' : 'productos actualizados'}
            {/* Los omitidos van en tono neutro: no hay nada que corregir. */}
            {omitidos > 0 ? (
              <span class="resumen-omitidos">
                {' · '}
                {omitidos} sin tocar{omitidoMotivo ? ` (${omitidoMotivo})` : ''}
              </span>
            ) : null}
            {fallidos > 0 ? (
              <span class="resumen-fallos">
                {' · '}
                {fallidos} con problemas{fallaron !== '' ? ` (${fallaron}${fallidos > 5 ? '…' : ''})` : ''}
                {motivo ? `: ${motivo}` : ''}
              </span>
            ) : null}
          </>
        )}
      </p>
    ) : null
  }

  {
    filas.length === 0 ? (
      <p class="vacio">
        No hay productos
        {busqueda !== '' ? (
          <>
            {' '}
            que coincidan con <strong>{busqueda}</strong>
          </>
        ) : null}{' '}
        en este filtro.
      </p>
    ) : (
      <form method="post" action={destinoPost} data-completos={completosParaAprobar}>
        {/* `data-completos` viaja al script: es lo que apaga «Aprobar los completos»
            cuando no hay ninguno. Lo cuenta el servidor con la misma validacion que va a
            correr la accion, y reimplementarla en el navegador crearia una segunda verdad
            que se separaria de la primera sin que nadie se entere.

            EL COMENTARIO VA ADENTRO DEL FORM Y NO ARRIBA. Justo antes de esta etiqueta
            esta el `: (` del ternario, y ahi Astro espera una EXPRESION: un comentario
            entre llaves solo ES un comentario donde se esperan HIJOS. En posicion de
            expresion se lee como un objeto literal y el compilador pierde el hilo del
            resto del archivo — el error sale como «Panel no tiene etiqueta de cierre», a
            300 lineas de distancia y sin ninguna relacion con la causa.

            Y por lo mismo: NO escribir llaves literales en un comentario. El parser las
            cuenta igual que si fueran codigo. */}
        {/* Para que la confirmación de /eliminar sepa a qué vista volver: filtro,
            búsqueda y página. Sin esto, eliminar desde la página 3 devuelve a la 1. */}
        <input type="hidden" name="volver" value={Astro.url.search.replace(/^\?/, '')} />
        {/* Arriba queda SOLO la categoría en lote, y no por descarte: es el único
            control que hay que operar —elegir del desplegable— y no un botón que se
            aprieta. Un select en una barra fija al pie abre su lista hacia arriba,
            tapando justamente las filas sobre las que se está por actuar. */}
        <p class="lote-fila lote-fila--sola">
          <label for="secundaria">Agregar categoría</label>
          <select id="secundaria" name="secundaria">
            {CATEGORIAS.map((c) => (
              <option value={c.id}>{c.nombre}</option>
            ))}
          </select>
          <button type="submit" name="accion" value="categorias" data-requiere="seleccion">
            Agregar
          </button>
        </p>

        <div class="tabla-marco">
          <table class="grilla">
            <caption class="oculto">
              Productos: código, foto, nombre, categoría principal, precio y estado. Cada
              producto lleva debajo una segunda fila con su descripción y si va destacado
              en la portada.
            </caption>
            {/* Anchos explicitos: con `table-layout: fixed` manda esto y no el
                contenido, asi el select no se lleva el ancho del nombre. */}
            <colgroup>
              <col style="width: 44px" />
              <col style="width: 6.5rem" />
              <col style="width: 72px" />
              <col />
              <col style="width: 12rem" />
              <col style="width: 8rem" />
              <col style="width: 11rem" />
            </colgroup>
            <thead>
              <tr>
                <th scope="col" class="col-elegir">
                  <span class="oculto">Seleccionar</span>
                </th>
                <th scope="col">Código</th>
                <th scope="col">Foto</th>
                <th scope="col">Nombre</th>
                <th scope="col">Categoría principal</th>
                <th scope="col">Precio</th>
                <th scope="col">Estado</th>
              </tr>
            </thead>
            {/* UN <tbody> POR PRODUCTO, no uno para toda la tabla. Varios tbody en una
                tabla son HTML valido, y es lo que dice que las dos filas de un producto
                son una unidad: el hover ilumina las dos juntas y el separador va entre
                productos, no entre las mitades de uno. */}
            {filas.map((p) => (
              <tbody>
                <tr class="fila-campos">
                  <td class="col-elegir">
                    {/* `fila` marca que esta fila viajo en el POST; `id` marca que
                        esta tildada. Guardar usa el primero y el lote el segundo. */}
                    <input type="hidden" name="fila" value={String(p.id)} />
                    <label class="elegir">
                      <input type="checkbox" name="id" value={String(p.id)} />
                      <span class="oculto">Seleccionar {p.codigo}</span>
                    </label>
                  </td>

                  {/* El codigo es el enlace a la ficha: es el dato con el que se
                      identifica el producto, asi que es donde la mano va a ir. */}
                  <th scope="row" class="codigo">
                    <a href={`/productos/${encodeURIComponent(p.codigo)}`}>{p.codigo}</a>
                  </th>

                  <td>
                    {p.miniatura ? (
                      <img
                        src={urlMiniatura(R2, p.miniatura, 300)}
                        alt=""
                        width="56"
                        height="56"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="sin-foto" role="img" aria-label="Sin imagen">
                        sin foto
                      </span>
                    )}
                  </td>

                  <td>
                    <label class="oculto" for={`nombre-${p.id}`}>
                      Nombre de {p.codigo}
                    </label>
                    {/* Un nombre igual al codigo es el marcador de "sin nombre" del importador
                        (SPEC.md §6.6): se pinta VACIO para que se complete, no para
                        que se edite el codigo.

                        Ojo con los comentarios de bloque: dentro de la lista de
                        atributos de una etiqueta, JSX los parsea como ATRIBUTOS y el
                        error habla de props inexistentes. Van afuera, envueltos en
                        llaves como este. */}
                    <input
                      id={`nombre-${p.id}`}
                      name={`nombre-${p.id}`}
                      type="text"
                      value={p.nombre && p.nombre !== p.codigo ? p.nombre : ''}
                      placeholder="Sin nombre"
                    />
                  </td>

                  <td>
                    <label class="oculto" for={`categoria-${p.id}`}>
                      Categoría principal de {p.codigo}
                    </label>
                    <select id={`categoria-${p.id}`} name={`categoria-${p.id}`}>
                      <option value="">— elegir —</option>
                      {CATEGORIAS.map((c) => (
                        <option value={c.id} selected={p.categorias[0] === c.id}>
                          {c.nombre}
                        </option>
                      ))}
                    </select>
                    {/* Las transversales se ven pero no se editan acá: se asignan en
                        lote, que es como funcionan (escolar, dama, fiesta cruzan
                        muchos productos a la vez). */}
                    {p.categorias.length > 1 ? (
                      <p class="secundarias">
                        + {p.categorias.slice(1).map((c) => nombreCategoria(c)).join(', ')}
                      </p>
                    ) : null}
                  </td>

                  <td>
                    <label class="oculto" for={`precio-${p.id}`}>
                      Precio de {p.codigo} en guaraníes
                    </label>
                    <input
                      id={`precio-${p.id}`}
                      name={`precio-${p.id}`}
                      type="text"
                      inputmode="numeric"
                      class="precio"
                      value={formatearPrecio(p.precio)}
                      placeholder="Consultar"
                    />
                  </td>

                  <td>
                    {/* Primero DONDE esta el producto, despues que le falta. El estado
                        es el dato que se busca; la validacion es la accion siguiente. */}
                    <p class="estado-actual" title={estadoLegible(p.estado).explicacion}>
                      {estadoLegible(p.estado).etiqueta}
                    </p>
                    {p.validacion.puede ? (
                      <span class="estado estado--ok">✓ completo</span>
                    ) : (
                      <span class="estado estado--falta">⚠ {p.validacion.faltantes.join(', ')}</span>
                    )}
                    {/* DEBAJO DEL ESTADO Y NO EN SU LUGAR: son dos ejes. Un producto
                        puede estar en el catálogo y dado de baja en el origen al mismo
                        tiempo, y tapar el primero con el segundo esconde justamente el
                        dato que dice si hay que apurarse. */}
                    {p.ausente_desde ? (
                      <span class="estado estado--baja">
                        ⚠ No está en el proveedor
                        <span class="nota">desde {haceCuanto(p.ausente_desde, ahora)}</span>
                      </span>
                    ) : null}
                  </td>
                </tr>

                {/* La segunda fila del producto: a todo lo ancho, para que la
                    descripcion tenga lugar de verdad sin robarle columnas al nombre. */}
                <tr class="fila-detalle">
                  <td colspan="7">
                    <div class="detalle">
                      {/* LA DESCRIPCION VA PRIMERO Y EL DESTACADO DESPUES.
                          Al principio era al revés, con la casilla alineada en la misma
                          columna que la de seleccionar. Se veía prolijo y estaba mal: dos
                          casillas en la misma columna vertical se leen como el mismo eje
                          de control, y no lo son — una elige sobre qué producto operar, la
                          otra es un DATO del producto. Separadas y de distinto porte se
                          distinguen solas. */}
                      <details class="descripcion">
                        {/* El resumen ADELANTA el contenido en vez de decir solo
                            "Descripcion": asi se recorren las 50 y se ve cual falta sin
                            abrir ninguna. Sin esto, plegar esconde justamente el dato
                            que dice donde hay trabajo. */}
                        <summary>
                          {/* El {' '} separa la etiqueta del adelanto tambien en el TEXTO
                              y no solo en pantalla. El `gap` del flex ya los separa a la
                              vista, asi que sin esto no se nota: pero el contenido dice
                              "Descripcionsin cargar", y eso es lo que lee un lector de
                              pantalla y lo que se copia al seleccionar la fila. */}
                          Descripción{' '}
                          <span class={p.descripcion ? 'desc-vista' : 'desc-vista desc-vista--falta'}>
                            {p.descripcion ?? 'sin cargar'}
                          </span>
                        </summary>
                        {/* El <summary> NO es una etiqueta de formulario: no asocia con
                            el control ni lo anuncia un lector de pantalla. El <label>
                            oculto es el que hace ese trabajo. */}
                        <label class="oculto" for={`descripcion-${p.id}`}>
                          Descripción de {p.codigo}
                        </label>
                        <textarea
                          id={`descripcion-${p.id}`}
                          name={`descripcion-${p.id}`}
                          rows="2"
                          placeholder="Para qué sirve, de qué material es, qué tamaño tiene."
                          >{p.descripcion ?? ''}</textarea
                        >
                      </details>

                      <label class="destacar">
                        {/* `checked` recibe un BOOLEANO desde `grilla.ts`. Con el 0/1
                            crudo de la columna saldrian tildadas las 50: en JSX un 0 es
                            un valor presente. */}
                        <input
                          type="checkbox"
                          name={`destacado-${p.id}`}
                          value="si"
                          checked={p.destacado}
                        />
                        Destacado en la portada
                      </label>
                    </div>
                  </td>
                </tr>
              </tbody>
            ))}
          </table>
        </div>

        {/**
         * TODOS los botones en la barra fija, y no repartidos entre arriba y abajo.
         *
         * Con 50 productos y dos filas cada uno son 100 `<tr>`: cualquier bloque de
         * acciones anclado a un extremo queda a un viaje de distancia desde el medio. La
         * barra esta siempre a la mano, asi que el lugar donde estan los botones deja de
         * ser una decision.
         *
         * `data-requiere` declara la condicion de cada uno; `scripts/grilla-cliente.ts`
         * la aplica. Nacen HABILITADOS a proposito: si el script no carga, la pantalla
         * sigue sirviendo y el servidor valida igual.
         */}
        <div class="barra-acciones" role="group" aria-label="Acciones">
          {/* `cambios` es el INVERSO de `guardado`: gris significa "tu trabajo esta
              guardado". Es el unico boton que no depende de nada mas — es la salida de
              emergencia de todo lo tipeado y no puede quedar bloqueado por otra cosa. */}
          <button type="submit" name="accion" value="guardar" data-requiere="cambios">
            Guardar cambios
          </button>

          <button type="submit" name="accion" value="aprobar" data-requiere="guardado seleccion">
            Aprobar
          </button>

          <button
            type="submit"
            name="accion"
            value="aprobar-completos"
            data-requiere="guardado completos"
          >
            Aprobar los completos ({completosParaAprobar})
          </button>

          {/* `formaction` a una pantalla propia: el barrido necesita un bucle con un
              pedido por segundo, que no cabe en un POST. */}
          <button
            type="submit"
            class="secundario"
            formaction="/barrido"
            formnovalidate
            data-requiere="seleccion"
          >
            Verificar en el proveedor
          </button>

          {/* `formaction` y no otra accion de esta pagina: eliminar necesita una pantalla
              de confirmacion que diga QUE va a pasar con cada producto (§12.2), y eso
              depende de una consulta a la base. */}
          <button
            type="submit"
            class="peligro"
            formaction="/eliminar"
            formnovalidate
            data-requiere="seleccion"
          >
            Eliminar
          </button>
        </div>
      </form>
    )
  }

  <nav class="paginado" aria-label="Paginado">
    {pagina > 1 ? <a href={enlace({ pagina: pagina - 1 })} rel="prev">← Anterior</a> : null}
    {totalDelFiltro > POR_PAGINA ? <span>Página {pagina}</span> : null}
    {hayMas ? <a href={enlace({ pagina: pagina + 1 })} rel="next">Siguiente →</a> : null}
  </nav>
</Panel>

<script>
  import { prepararGrilla } from '../scripts/grilla-cliente.ts';

  prepararGrilla();
</script>
