---
/**
 * Editar o eliminar un pedido especial (SPEC.md §4.5, SPEC-etapa2 §10.6).
 *
 * POR SLUG y no por id: la dirección de esta pantalla dice qué se está editando, y es
 * el mismo identificador que ve el cliente en el sitio.
 *
 * EL BORRADO VIVE ACA Y NO EN LA LISTA, y no hay pantalla de confirmación como la de
 * productos (§12.2). Son unas pocas fichas manejadas a mano: pedir una confirmación
 * para cada una es ceremonia. Pero tampoco va en la lista, donde borrar sería errarle a
 * una fila entre diez; acá ya se está mirando la ficha que se borra.
 */
import { env } from 'cloudflare:workers';

import Panel from '../../layouts/Panel.astro';
import { ejecutorD1 } from '../../lib/d1.ts';
import { baseDeImagenes, urlMiniatura } from '../../lib/imagenes.ts';
import {
  actualizarPedidoEspecial,
  buscarPorSlug,
  eliminarPedidoEspecial,
} from '../../lib/pedidos-especiales.ts';

const ejecutar = ejecutorD1(env.DB);

// En dev, el R2 LOCAL via `/img-dev`; en produccion, el bucket. Ver `baseDeImagenes`.
const R2 = baseDeImagenes({ baseR2: env.PUBLIC_R2_BASE, dev: import.meta.env.DEV });
const { slug } = Astro.params;

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const texto = (c: string) => String(datos.get(c) ?? '').trim();
  const id = Number(texto('id'));

  try {
    if (texto('accion') === 'eliminar') {
      await eliminarPedidoEspecial(ejecutar, id);
      return Astro.redirect(
        `/pedidos-especiales?hecho=${encodeURIComponent(
          `Ficha eliminada. Su dirección /pedidos-especiales/${slug} queda en 404 al publicar.`
        )}`,
        303
      );
    }

    await actualizarPedidoEspecial(
      ejecutar,
      id,
      {
        nombre: texto('nombre'),
        descripcion: texto('descripcion'),
        orden: texto('orden') === '' ? 999 : Number(texto('orden')),
        hash16: texto('hash16'),
      },
      { ahora: new Date().toISOString() }
    );

    return Astro.redirect(
      `/pedidos-especiales?hecho=${encodeURIComponent(
        'Cambios guardados. Publicá para que salgan al sitio.'
      )}`,
      303
    );
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
  }
}

/**
 * Se relee DESPUES del POST: si el guardado falló, lo que se muestra tiene que ser el
 * estado real de la base y no lo que se intentó escribir.
 */
const pedido = await buscarPorSlug(ejecutar, slug ?? '');

// Un slug inexistente es una URL vieja o mal tipeada, no un error del programa.
if (!pedido) {
  return new Response('No existe esa ficha.', { status: 404 });
}

const miniatura = urlMiniatura(R2, pedido.hash16, 300);
---

<Panel titulo={pedido.nombre} volver="/pedidos-especiales">
  <h1>{pedido.nombre}</h1>
  <p class="nota">/pedidos-especiales/{pedido.slug}</p>

  {error ? <p class="resumen resumen--error" role="status">{error}</p> : null}

  <form method="post" class="alta" data-formulario-pedido>
    <input type="hidden" name="id" value={pedido.id} />

    <fieldset class="lote">
      <legend>Datos</legend>

      <p class="campo">
        <label for="nombre">Nombre *</label>
        <input id="nombre" name="nombre" value={pedido.nombre} required />
        {/* La regla dicha donde se puede desobedecer: acá es donde alguien esperaría
            que renombrar mueva la URL (SPEC.md §6.7). */}
        <span class="nota">
          Cambiarlo NO cambia la dirección: sigue siendo /pedidos-especiales/{pedido.slug}.
        </span>
      </p>

      <p class="campo">
        <label for="descripcion">Descripción *</label>
        <textarea id="descripcion" name="descripcion" rows="7" required
          >{pedido.descripcion}</textarea
        >
        <span class="nota">
          Es TODO lo que se ve al entrar a la ficha. Un renglón por dato: cantidad mínima,
          materiales, plazos. Los saltos de línea se respetan en el sitio.
        </span>
      </p>

      <p class="campo">
        <label for="orden">Orden</label>
        <input id="orden" name="orden" type="number" min="0" value={pedido.orden} />
        <span class="nota">Más chico, más arriba.</span>
      </p>
    </fieldset>

    <fieldset class="lote" data-foto-pedido>
      <legend>Foto</legend>
      <input type="hidden" name="hash16" value={pedido.hash16} data-hash />
      <p class="vista-previa" data-vista>
        <img src={miniatura} alt="" width="120" height="120" />
      </p>
      <p class="campo">
        <input type="file" accept="image/*" data-archivo />
        <span class="nota" data-estado>Elegí un archivo sólo si querés reemplazarla.</span>
      </p>
    </fieldset>

    <p class="pie-guardar">
      <button type="submit">Guardar cambios</button>
      <span class="nota">Después hay que publicar para que salgan al sitio.</span>
    </p>
  </form>

  {/*
    FUERA del formulario de edición: dos botones de submit en el mismo `<form>` se
    aprietan por error, y uno de los dos no tiene vuelta.
  */}
  <form method="post" class="pe-peligro">
    <input type="hidden" name="id" value={pedido.id} />
    <p class="pie-guardar">
      <button name="accion" value="eliminar">Eliminar esta ficha</button>
      <span class="nota">
        Sin vuelta. Al publicar, /pedidos-especiales/{pedido.slug} queda en 404 para quien la
        tenga guardada.
      </span>
    </p>
  </form>
</Panel>

<script>
  import { montarFotoDePedido } from '../../scripts/pedidos-especiales-cliente.ts';

  for (const caja of document.querySelectorAll<HTMLElement>('[data-foto-pedido]')) {
    montarFotoDePedido(caja);
  }
</script>
