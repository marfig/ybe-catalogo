---
/**
 * Envoltorio de todas las pantallas del admin.
 *
 * Existe desde la primera pantalla y no cuando aparezca la segunda: el `<head>`, el
 * `noindex` y la identidad de la sesion son cosas que NO se pueden olvidar en una
 * pagina nueva, y un layout es lo que impide olvidarlas.
 */
import '../styles/panel.css';
import { rotuloDeVuelta } from '../lib/navegacion.ts';

interface Props {
  titulo: string;
  /** Ruta de vuelta. Sin esto, de una pantalla interna sólo se sale con el navegador. */
  volver?: string;
  /**
   * A dónde dice que vuelve. Por default se DERIVA de `volver`, así que no hay que
   * pasarlo casi nunca.
   *
   * ESTE PARAMETRO YA ARREGLO ESTE BUG UNA VEZ, Y NO ALCANZO. El texto era «Inicio»
   * fijo mientras el `href` era el que le pasaran, así que una pantalla que vuelve a
   * una lista intermedia anunciaba un destino y llevaba a otro. Se agregó el parámetro…
   * con «Inicio» de default, o sea que la mentira siguió disponible por omisión: editar
   * un producto y eliminar productos vuelven a `/productos` y las dos decían «Inicio».
   *
   * Por eso ahora el default sale de `rotuloDeVuelta(volver)`, que tiene tests y una
   * invariante: sólo la raíz dice «Inicio». Confiar en que cada pantalla nueva se
   * acuerde de pasar el rótulo no era un arreglo, era el mismo bug con un parámetro más.
   *
   * Sigue existiendo como OVERRIDE para cuando el destino se llame distinto de lo que
   * la ruta sugiere.
   */
  volverTexto?: string;
  /**
   * Segundos para recargar sola la pantalla. Ausente = no se recarga.
   *
   * Es para el ÚNICO caso en que el estado cambia sin que nadie toque nada: mientras
   * corre una publicación, que termina en otra máquina y avisa por la base (§11.3).
   * Sin esto el cartel dice «Publicando…» hasta que alguien recarga a mano, aunque el
   * sitio ya esté publicado hace rato.
   *
   * `http-equiv` y no JavaScript, por tres razones que importan acá:
   *
   *  1. **Se apaga solo.** Quien decide si hay que refrescar es el servidor, en cada
   *     render. Cuando la publicación termina, la página que vuelve ya no trae la
   *     etiqueta y los refrescos paran. Con un `setInterval` habría que acordarse de
   *     cancelarlo, y el modo de falla sería recargar para siempre.
   *  2. Funciona sin JS, como el resto de esta pantalla.
   *  3. No hay estado que perder: el Inicio no tiene campos donde se esté tipeando.
   */
  refrescarCada?: number;
}

const { titulo, volver, volverTexto, refrescarCada } = Astro.props;
const rotuloVolver = volverTexto ?? rotuloDeVuelta(volver ?? '/');
const { identidad } = Astro.locals;
---

<!doctype html>
<html lang="es-PY">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* El admin nunca se indexa: es una superficie privada detras de Access. */}
    <meta name="robots" content="noindex, nofollow" />
    {refrescarCada ? <meta http-equiv="refresh" content={String(refrescarCada)} /> : null}
    <title>{titulo} · YBE Administración</title>
  </head>
  <body>
    <header class="panel-cabecera">
      <div class="contenedor">
        <div>
          {volver ? <a class="volver" href={volver}>← {rotuloVolver}</a> : null}
          {/**
           * El titulo y lo que la pantalla quiera poner a su lado.
           *
           * El slot vive ACA, pegado al `<h1>`, y no como una franja aparte: lo que va
           * en el es ayuda SOBRE esta pantalla, y en un encabezado propio se leeria
           * como una accion de la aplicacion. Las pantallas que no lo usan no rinden
           * nada — un slot vacio no ocupa lugar.
           */}
          <div class="titulo-fila">
            <h1>{titulo}</h1>
            <slot name="junto-al-titulo" />
          </div>
        </div>
        <p class="sesion">Sesión de <strong>{identidad.email}</strong></p>
      </div>
    </header>

    <div class="contenedor">
      <slot />
    </div>
  </body>
</html>
