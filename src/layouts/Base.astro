---
import { INDEXABLE } from 'astro:env/server';
import { urlCanonica } from '../lib/seo.ts';
import { COMERCIO, DESCRIPCION_SITIO } from '../lib/sitio.ts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion?: string | undefined;
  ogType?: 'website' | 'product';
  ogImagen?: string | undefined;
  jsonLd?: unknown[];
  /**
   * Fuerza `noindex, nofollow` para ESTA pagina, sin tocar `INDEXABLE` (global, por
   * variable de entorno).
   *
   * Nace con el soft launch de Regalos empresariales (`REGALOS_EMPRESARIALES_PUBLICADO`
   * en `lib/sitio.ts`): esa pagina esta construida y alcanzable por URL directa desde
   * el dia uno, aunque ningun enlace del sitio apunte a ella todavia —es la forma en
   * que se la revisa y se prueban los botones de WhatsApp antes de aprobarla, mandando
   * el enlace por WhatsApp—, y un enlace de prueba se filtra: capturas, reenvios, la
   * propia previsualizacion de WhatsApp. Sin este forzado, un rastreador que la
   * encuentre por ese camino la indexaria con el `INDEXABLE` de produccion en `true`,
   * antes del lanzamiento.
   *
   * Default `false`: toda pagina existente sigue dependiendo solo de `INDEXABLE`,
   * BYTE A BYTE igual que antes de que este prop existiera.
   */
  forzarNoIndexar?: boolean;
}

const {
  titulo,
  descripcion = DESCRIPCION_SITIO,
  ogType = 'website',
  ogImagen,
  jsonLd = [],
  forzarNoIndexar = false,
} = Astro.props;

// NO se usa Astro.url.pathname directo: con build.format 'file' daria
// /index.html. Ver SPEC §7.1.
const canonical = urlCanonica(Astro.url.pathname, Astro.site);
const tituloCompleto = titulo === COMERCIO ? COMERCIO : `${titulo} — ${COMERCIO}`;
---

<!doctype html>
<html lang="es-PY">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      Sin un `<link rel="icon">` declarado el navegador pide `/favicon.ico` por su cuenta
      y se come un 404 en cada visita. Los archivos salen del mismo logo, recortados al
      trazo: el asset trae margen transparente y sin sacarlo la medalla se ve diminuta en
      una pestana de 16px — la misma correccion que `Logo.astro` hace con `transform`.
    */}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical.href} />

    {/* Falla segura: sin INDEXABLE explicito el sitio NO se indexa (SPEC §7.2).
        `forzarNoIndexar` se suma con OR y nunca lo reemplaza: una pagina puede pedir
        noindex para si misma, pero ninguna pagina puede des-forzar el noindex global. */}
    {(!INDEXABLE || forzarNoIndexar) && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={COMERCIO} />
    <meta property="og:locale" content="es_PY" />
    {ogImagen && <meta property="og:image" content={ogImagen} />}
    <meta name="twitter:card" content="summary_large_image" />

    {
      jsonLd.map((bloque) => (
        <script type="application/ld+json" set:html={JSON.stringify(bloque)} />
      ))
    }
  </head>

  <body class="bg-fondo text-texto flex min-h-screen flex-col">
    <Header />
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-4 sm:px-6 sm:py-5">
      <slot />
    </main>
    <Footer />
  </body>
</html>
