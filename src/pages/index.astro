---
import Base from '../layouts/Base.astro';
import GrillaProductos from '../components/GrillaProductos.astro';
import { categoriasNavegables, destacados } from '../lib/productos.ts';
import { COMERCIO, DESCRIPCION_SITIO, MARCA, REDES } from '../lib/sitio.ts';
import { urlCanonica } from '../lib/seo.ts';

const productosDestacados = await destacados();

// Solo categorias con algo publicado, misma fuente que el header y que
// getStaticPaths del listado (SPEC §4.3).
const navegables = await categoriasNavegables();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: COMERCIO,
    url: urlCanonica('/', Astro.site).href,
    ...(REDES.length > 0 ? { sameAs: REDES } : {}),
  },
];
---

<Base titulo={COMERCIO} descripcion={DESCRIPCION_SITIO} jsonLd={jsonLd}>
  <h1 class="text-2xl font-semibold sm:text-3xl">Catálogo {MARCA}</h1>
  <p class="text-texto-suave mt-2 max-w-prose">{DESCRIPCION_SITIO}</p>

  <section class="mt-8" aria-labelledby="h-categorias">
    <h2 id="h-categorias" class="text-lg font-semibold">Categorías</h2>
    <ul class="mt-3 flex flex-wrap gap-2">
      {
        navegables.map(({ categoria, cantidad }) => (
          <li>
            <a
              href={`/categorias/${categoria.id}`}
              class="border-borde bg-superficie hover:border-acento flex items-baseline gap-2 rounded border px-3 py-2 text-sm"
            >
              {categoria.data.nombre}
              <span class="text-texto-suave text-xs">{cantidad}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-10" aria-labelledby="h-destacados">
    <h2 id="h-destacados" class="text-lg font-semibold">Destacados</h2>
    <div class="mt-3">
      <GrillaProductos
        productos={productosDestacados}
        vacio="Todavía no hay productos destacados."
      />
    </div>
  </section>
</Base>
