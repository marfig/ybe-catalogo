---
import Base from '../layouts/Base.astro';
import GrillaPedidosEspeciales from '../components/GrillaPedidosEspeciales.astro';
import { categoriasNavegables } from '../lib/productos.ts';
import { pedidosEspeciales } from '../lib/pedidos-especiales.ts';
import { COMERCIO, DESCRIPCION_LINEAS, DESCRIPCION_SITIO, REDES } from '../lib/sitio.ts';
import { urlCanonica } from '../lib/seo.ts';

const pedidos = await pedidosEspeciales();

// Solo categorias con algo publicado, misma fuente que el header y que
// getStaticPaths del listado (SPEC §4.3).
const navegables = await categoriasNavegables();

/**
 * La home muestra un ADELANTO, no el indice.
 *
 * Con las 24 categorias del archivo la lista completa medía ~750px de alto en un
 * movil, entre el buscador y los pedidos especiales: para llegar a un producto habia
 * pasar por el indice entero. El indice completo vive en `/categorias`, que es una
 * pagina donde la lista ES el contenido.
 *
 * OCHO porque es lo que llena cuatro columnas en dos filas justas, y porque el alto
 * del bloque queda acotado por esta constante y no por cuantas categorias haya.
 *
 * Las primeras por `orden`, igual que en el header: `orden` ya es la prioridad de
 * navegacion que declara `categorias.json`, asi que quien elige que se adelanta es
 * quien edita ese archivo.
 */
const EN_LA_HOME = 8;
const adelanto = navegables.slice(0, EN_LA_HOME);
const hayMas = navegables.length > adelanto.length;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: COMERCIO,
    url: urlCanonica('/', Astro.site).href,
    ...(REDES.length > 0 ? { sameAs: REDES } : {}),
  },
];
---

<Base titulo={COMERCIO} descripcion={DESCRIPCION_SITIO} jsonLd={jsonLd}>
  {/* Una frase por linea, con el corte EXPLICITO y no a merced del ancho.
      El <br> vive aca y no en la constante: es una decision de esta pantalla, y la
      misma constante alimenta la <meta description>, donde el marcado no va.

      Sin max-w-prose: ese limite existia para que el ancho no partiera la frase en
      un lugar arbitrario, y con los cortes puestos a mano ya no hace falta. */}
  <p class="text-texto-suave text-sm">
    {
      DESCRIPCION_LINEAS.map((linea, i) => (
        <>
          {i > 0 ? <br /> : null}
          {linea}
        </>
      ))
    }
  </p>

  <section class="mt-5" aria-labelledby="h-categorias">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 id="h-categorias" class="text-lg font-semibold">Categorías</h2>

      {/*
        El enlace va ARRIBA, en la misma linea que el titulo, y no al final de la
        lista: arriba se ve sin scrollear y avisa que hay mas antes de que alguien
        recorra las ocho creyendo que son todas.
      */}
      {
        hayMas && (
          <a href="/categorias" class="hover:text-texto text-texto-suave text-sm underline">
            Ver todas ({navegables.length})
          </a>
        )
      }
    </div>

    {/*
      GRILLA Y NO `flex-wrap`, que era lo que estaba: con chips de ancho segun el texto,
      «Bandolera para Dama» quedaba sola en una fila y la ultima con un chip suelto. El
      borde derecho quedaba dentado y las filas con huecos distintos.

      Columnas fijas: todas las celdas miden lo mismo, asi que los bordes se alinean
      vertical y horizontalmente pase lo que pase con los nombres. Dos en movil porque un
      nombre largo no entra en media pantalla de 375px si se meten tres.
    */}
    <ul class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4">
      {
        adelanto.map(({ categoria, cantidad }) => (
          <li>
            <a
              href={`/categorias/${categoria.id}`}
              class="border-borde bg-superficie hover:border-acento flex h-full items-baseline justify-between gap-2 rounded border px-3 py-2 text-sm"
            >
              {/* `justify-between` con la celda ya pareja: el conteo cae contra el borde
                  derecho de TODAS, asi que se leen como una columna. `h-full` iguala el
                  alto cuando un nombre largo se parte en dos lineas. */}
              <span>{categoria.data.nombre}</span>
              <span class="text-texto-suave text-xs">{cantidad}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/*
    Reemplaza al bloque de «Destacados», que era una curaduría sobre `productos` con un
    flag `destacado`. Se cambió porque estos artículos NO son productos del catálogo:
    no tienen SKU, ni color, ni precio de lista. Ver `content.config.ts`.

    LA SECCIÓN SE OCULTA ENTERA SI NO HAY NADA, y por eso no se le pasa un `vacio`.
    Es la diferencia con un listado: `/categorias/x` vacío tiene que explicar por qué
    no hay nada, porque el visitante pidió esa página. Acá nadie la pidió — un «todavía
    no hay» en la portada anuncia un hueco que el visitante no sabía que existía.
  */}
  {
    pedidos.length > 0 && (
      <section class="mt-10" aria-labelledby="h-pedidos-especiales">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 id="h-pedidos-especiales" class="text-lg font-semibold">
            Pedidos especiales
          </h2>

          {/* Mismo patrón que «Ver todas» de categorías: arriba y en la línea del
              título, donde se ve sin scrollear la grilla entera. */}
          <a
            href="/pedidos-especiales"
            class="hover:text-texto text-texto-suave text-sm underline"
          >
            Ver todos
          </a>
        </div>

        {/* La bajada NO es decorativa: estas tarjetas no llevan precio, y sin una línea
            que lo explique la ausencia se lee como un dato que falta. */}
        <p class="text-texto-suave mt-1 text-sm">
          Por cantidad, para colegios y empresas. Cotizamos según tu pedido.
        </p>

        {/* `denso`: la portada es un ADELANTO, igual que el bloque de categorias de
            arriba. Con la grilla de la pagina propia este bloque se come la pantalla. */}
        <div class="mt-3">
          <GrillaPedidosEspeciales pedidos={pedidos} denso />
        </div>
      </section>
    )
  }
</Base>
