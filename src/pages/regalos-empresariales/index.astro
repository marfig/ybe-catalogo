---
import { PUBLIC_WHATSAPP } from 'astro:env/client';
import Base from '../../layouts/Base.astro';
import TarjetaRegaloEmpresarial from '../../components/TarjetaRegaloEmpresarial.astro';
import { agruparPorSeccion } from '../../lib/corporativo.ts';
import { regalosEmpresariales } from '../../lib/regalos-empresariales.ts';
import { urlCanonica } from '../../lib/seo.ts';
import { COMERCIO } from '../../lib/sitio.ts';

const TITULO = 'Regalos empresariales';
const BAJADA =
  'Para regalos corporativos y pedidos en cantidad. El precio se cotiza según la ' +
  'cantidad que necesites: consultanos por WhatsApp con la referencia del artículo ' +
  'que elijas.';

const productos = await regalosEmpresariales();
const grupos = agruparPorSeccion(productos);

/**
 * Id de anclaje derivado del titulo de seccion, TAL CUAL sale impreso (con tildes,
 * mayusculas y la barra de «MOCHILA P/NOTEBOOK»). El titulo visible usa ese texto
 * sin tocar (mas abajo); esto es solo para tener un `id` valido de HTML al que
 * `aria-labelledby` pueda apuntar.
 */
function idSeccion(seccion: string): string {
  return seccion
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}

const canonical = urlCanonica(Astro.url.pathname, Astro.site);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: TITULO,
    description: BAJADA,
    url: canonical.href,
    isPartOf: { '@type': 'WebSite', name: COMERCIO },
  },
];
---

<Base titulo={TITULO} descripcion={BAJADA} jsonLd={jsonLd}>
  <nav aria-label="Migas de pan" class="text-texto-suave text-sm">
    <ol class="flex flex-wrap items-center gap-1">
      <li><a href="/" class="hover:text-texto underline">Inicio</a></li>
      <li aria-hidden="true">›</li>
      <li aria-current="page" class="text-texto">{TITULO}</li>
    </ol>
  </nav>

  <h1 class="mt-4 text-xl font-semibold sm:text-2xl">{TITULO}</h1>

  {/*
    La bajada explica la ausencia de precio, mismo motivo que en `pedidos-especiales`:
    sin esta linea, la falta de un monto se lee como un dato que falta, no como la
    propuesta de la seccion.
  */}
  {/*
    SIN `max-w-prose`, al reves que la descripcion de la ficha de producto: se pidio
    que la bajada ocupe todo el ancho de la columna. El tope de medida lo sigue
    poniendo el `max-w-6xl` de `layouts/Base.astro`, asi que el renglon no crece sin
    limite por mucho que se agrande la pantalla.
  */}
  <p class="text-texto-suave mt-2 text-sm leading-relaxed">{BAJADA}</p>

  {
    grupos.length === 0 ? (
      <p class="text-texto-suave py-8">Todavía no hay artículos cargados en esta sección.</p>
    ) : (
      /*
        AGRUPADO POR SECCION IMPRESA y no por categoria del catalogo normal: esta
        pagina reproduce el catalogo en papel, y el papel se hojea por sus propias
        secciones («BOLSO TÉRMICO», «MOCHILA P/NOTEBOOK»), no por la taxonomia del
        sitio — las dos pueden nombrar las cosas distinto.
      */
      grupos.map((grupo) => (
        <section class="mt-8" aria-labelledby={`h-sec-${idSeccion(grupo.seccion)}`}>
          <h2 id={`h-sec-${idSeccion(grupo.seccion)}`} class="text-lg font-semibold">
            {grupo.seccion}
          </h2>

          <ul class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4">
            {grupo.productos.map((producto) => (
              <TarjetaRegaloEmpresarial
                producto={producto}
                telefono={PUBLIC_WHATSAPP}
                urlPagina={canonical.href}
              />
            ))}
          </ul>
        </section>
      ))
    )
  }
</Base>
