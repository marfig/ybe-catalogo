---
import Logo from './Logo.astro';
import Buscador from './islas/Buscador.tsx';
import { COMERCIO, NOMBRE_CORTO } from '../lib/sitio.ts';
import { categoriasNavegables } from '../lib/productos.ts';

const { PUBLIC_R2_BASE } = import.meta.env;

// Solo categorias con productos publicados: el header no puede enlazar a una
// pagina que no se genera (SPEC §4.3).
const categorias = (await categoriasNavegables()).map((c) => c.categoria);
---

{/*
  Dos filas: marca arriba, navegacion abajo.

  Con el logo grande la nav no entra en la misma linea, y apretarla a la derecha
  la volvia un carrusel de 9 chips en un hueco de 200px. Separar filas le da aire
  al logo y deja la nav legible.

  Sticky solo la fila de marca: dos filas fijas comerian ~130px de viewport en
  movil, que en una grilla de productos es carisimo.
*/}
<header class="bg-superficie border-borde border-b">
  <div class="bg-superficie border-borde sticky top-0 z-20 border-b">
    <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3 sm:gap-4 sm:px-6 sm:py-4">
      {/* `min-w-0` y el `truncate` del wordmark hacen que la marca CEDA ancho cuando
          la pantalla es angosta, en vez de empujar al buscador fuera de la fila. El
          logo no se achica: es el ancla visual. */}
      <a
        href="/"
        class="flex min-w-0 shrink items-center gap-3 sm:gap-4"
        aria-label={`${COMERCIO} — inicio`}
      >
        <Logo class="h-16 w-16 sm:h-22 sm:w-22" prioridad />

        {/* Wordmark en texto HTML, no imagen: escala, es seleccionable y no pesa */}
        <span class="flex min-w-0 flex-col leading-tight">
          <span class="truncate text-xl font-semibold sm:text-3xl">
            {NOMBRE_CORTO}
          </span>
          <span class="text-texto-suave text-xs tracking-widest sm:text-sm">
            {COMERCIO}
          </span>
        </span>
      </a>

      {/*
        En la MISMA fila que la marca, del otro lado: aprovecha el ancho que en
        escritorio queda vacio a la derecha del logo, y no suma alto al header — que
        sticky se paga en viewport, sobre todo en movil.

        `ml-auto` lo empuja a la derecha; `min-w-0` con `max-w` lo deja encoger sin
        desbordar. La marca cede ancho antes que el buscador porque el logo sigue ahi
        como ancla: en una pantalla angosta se pierde el wordmark, no la funcion.

        `client:idle` y no `client:visible`: esta visible desde el primer pixel, asi
        que `visible` lo hidrataria compitiendo con el render inicial. Con `idle`
        espera a que el navegador este libre (SPEC §9.4).
      */}
      <div class="ml-auto w-full max-w-40 min-w-0 sm:max-w-xs">
        <Buscador client:idle r2Base={PUBLIC_R2_BASE} />
      </div>
    </div>
  </div>

  <nav aria-label="Categorías" class="mx-auto max-w-6xl px-4 sm:px-6">
    <ul class="flex gap-1 overflow-x-auto py-2 text-sm whitespace-nowrap">
      {
        categorias.map((c) => (
          <li>
            <a
              href={`/categorias/${c.id}`}
              class="hover:bg-fondo hover:text-texto text-texto-suave block rounded px-2 py-1"
            >
              {c.data.nombre}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
