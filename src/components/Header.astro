---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { COMERCIO } from '../lib/sitio.ts';
import { categoriasNavegables } from '../lib/productos.ts';

// Solo categorias con productos publicados: el header no puede enlazar a una
// pagina que no se genera (SPEC §4.3).
const categorias = (await categoriasNavegables()).map((c) => c.categoria);
---

<header
  class="bg-superficie border-borde sticky top-0 z-20 border-b"
>
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-3 px-4 sm:h-16 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2" aria-label={`${COMERCIO} — inicio`}>
      {/*
        Lockup horizontal: el emblema completo a 40px deja el texto curvo
        "CHENSON" en ~7px, ilegible. El wordmark es texto HTML, no imagen
        (SPEC §3.4). alt="" porque el nombre ya esta en el texto de al lado.
      */}
      <Image src={logo} width={48} height={48} alt="" loading="eager" class="h-10 w-10 sm:h-12 sm:w-12" />
      <span class="hidden text-xl font-semibold sm:inline">{COMERCIO}</span>
    </a>

    <nav aria-label="Categorías" class="ml-auto min-w-0">
      <ul class="flex gap-1 overflow-x-auto text-sm whitespace-nowrap">
        {
          categorias.map((c) => (
            <li>
              <a
                href={`/categorias/${c.id}`}
                class="hover:bg-fondo hover:text-texto text-texto-suave block rounded px-2 py-1"
              >
                {c.data.nombre}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
