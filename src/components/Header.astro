---
import Logo from './Logo.astro';
import { COMERCIO, NOMBRE_CORTO } from '../lib/sitio.ts';
import { categoriasNavegables } from '../lib/productos.ts';

// Solo categorias con productos publicados: el header no puede enlazar a una
// pagina que no se genera (SPEC §4.3).
const categorias = (await categoriasNavegables()).map((c) => c.categoria);
---

{/*
  Dos filas: marca arriba, navegacion abajo.

  Con el logo grande la nav no entra en la misma linea, y apretarla a la derecha
  la volvia un carrusel de 9 chips en un hueco de 200px. Separar filas le da aire
  al logo y deja la nav legible.

  Sticky solo la fila de marca: dos filas fijas comerian ~130px de viewport en
  movil, que en una grilla de productos es carisimo.
*/}
<header class="bg-superficie border-borde border-b">
  <div class="bg-superficie border-borde sticky top-0 z-20 border-b">
    <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3 sm:gap-4 sm:px-6 sm:py-4">
      <a
        href="/"
        class="flex min-w-0 items-center gap-3 sm:gap-4"
        aria-label={`${COMERCIO} — inicio`}
      >
        <Logo class="h-16 w-16 sm:h-22 sm:w-22" prioridad />

        {/* Wordmark en texto HTML, no imagen: escala, es seleccionable y no pesa */}
        <span class="flex min-w-0 flex-col leading-tight">
          <span class="truncate text-lg font-semibold sm:text-2xl">
            Chenson <span class="hidden sm:inline">Asunción</span>
          </span>
          <span class="text-texto-suave text-xs tracking-widest uppercase sm:text-sm">
            {NOMBRE_CORTO}
          </span>
        </span>
      </a>
    </div>
  </div>

  <nav aria-label="Categorías" class="mx-auto max-w-6xl px-4 sm:px-6">
    <ul class="flex gap-1 overflow-x-auto py-2 text-sm whitespace-nowrap">
      {
        categorias.map((c) => (
          <li>
            <a
              href={`/categorias/${c.id}`}
              class="hover:bg-fondo hover:text-texto text-texto-suave block rounded px-2 py-1"
            >
              {c.data.nombre}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
