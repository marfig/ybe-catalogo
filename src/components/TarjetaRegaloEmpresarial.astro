---
import { SIZES_CARD } from '../lib/imagenes.ts';
import type { ProductoCorporativo } from '../lib/corporativo.ts';
import { construirEnlaceWa } from '../lib/whatsapp.ts';
import IconoWhatsApp from './IconoWhatsApp.tsx';
import ImagenProducto from './ImagenProducto.astro';

interface Props {
  producto: ProductoCorporativo;
  telefono: string;
  /** URL canonica ABSOLUTA de `/regalos-empresariales`, sin el `#ancla`. */
  urlPagina: string;
}

const { producto, telefono, urlPagina } = Astro.props;

/**
 * El ancla que hace de `id` de la tarjeta y de destino del enlace de WhatsApp.
 *
 * El CODIGO IMPRESO y no `producto.id` (el slug de Astro): es el dato que aparece en
 * el catalogo en papel — la clave de identidad que va a buscar quien reenvia el
 * enlace o llama preguntando por una referencia. El slug es un detalle de
 * implementacion de este sitio que podria cambiar sin que el codigo se mueva.
 */
const ancla = `ref-${producto.codigo}`;

/**
 * SIN `/productos/${producto.id}` en ningun lado de esta tarjeta, ni siquiera como
 * enlace de la foto o el nombre.
 *
 * Esa ficha muestra el PRECIO DE LISTA (`TarjetaProducto`/`Precio.astro`), y el precio
 * de lista no es el precio de un pedido corporativo — se cotiza aparte, segun
 * cantidad. Un enlace «de paso» a esa ficha le mostraria a quien compra por volumen un
 * numero que no le corresponde y que además contradice el motivo de que esta seccion
 * exista.
 */
const enlaceWa = construirEnlaceWa({
  telefono,
  nombre: producto.nombre,
  url: `${urlPagina}#${ancla}`,
  codigo: producto.codigo,
  saludo: 'Hola! Quisiera cotizar este producto para un pedido empresarial:',
});

/**
 * El color PRINCIPAL siempre existe (dato verificado al cargar `regalos-empresariales.json`:
 * exactamente un color por entrada trae `alternativo: false`), pero `find` igual
 * tipa como opcional — no vale la pena un assert que solo puede fallar si el JSON
 * verificado se corrompe.
 */
const principal = producto.colores.find((c) => !c.alternativo);
const alternativos = producto.colores.filter((c) => c.alternativo);
---

<li
  id={ancla}
  class="border-borde bg-superficie scroll-mt-24 flex flex-col overflow-hidden rounded border"
>
  <ImagenProducto imagen={producto.imagen} alt={producto.nombre} sizes={SIZES_CARD} compacto />

  <div class="flex flex-1 flex-col gap-1 p-3">
    {
      /* El nombre SE MANTIENE aunque el impreso no lo traiga: una tarjeta sin texto
      identificable es inutil para un lector de pantalla, y el mensaje de WhatsApp
      (arriba) lo necesita para no llegar como «Hola, quisiera cotizar Ref. 1234». */
    }
    <h3 class="text-sm leading-snug font-medium">{producto.nombre}</h3>

    <p class="text-texto-suave text-xs">
      Ref.: <code class="text-texto">{producto.codigo}</code>
    </p>

    {
      // Solo 6 de las 112 entradas la traen (ver content.config.ts): una anotacion
      // suelta del impreso, tipo «sin tira larga» o «Porta notebook».
      producto.etiqueta && <p class="text-texto-suave text-xs">{producto.etiqueta}</p>
    }

    {
      /* El codigo de color junto al nombre, `(3) NEGRO`, tal como lo imprime el
      catalogo: quien pide por telefono lee el codigo, no adivina "negro" entre
      variantes que pueden compartir nombre. Los nombres llegan en MAYUSCULA porque
      asi los imprimio el catalogo — es el registro que esta pagina reproduce, no un
      descuido de carga. */
      principal && (
        <p class="text-texto-suave text-xs">
          ({principal.codigo}) {principal.nombre}
        </p>
      )
    }

    {
      alternativos.length > 0 && (
        <p class="text-texto-suave text-xs">
          También disponible en:{' '}
          {alternativos.map((c) => `(${c.codigo}) ${c.nombre}`).join(', ')}
        </p>
      )
    }

    {
      // Literal del impreso («Consulte los demas colores»), no una frase propia de
      // esta pagina: son las entradas que el catalogo marca con esa leyenda.
      producto.consultarOtros && (
        <p class="text-texto-suave text-xs">Consulte los demás colores.</p>
      )
    }

    <p class="text-texto-suave text-xs">
      Medidas aprox. (alto x largo x ancho): {producto.medidas} cm
    </p>

    <div class="mt-auto pt-2">
      {
        /* `aria-label` completo y NO el texto visible «Consultar» a secas: un lector
        de pantalla que repite «Consultar» 112 veces no le dice a quien navega CUAL
        producto va a preguntar en cada boton. Arranca con el texto visible para
        cumplir 2.5.3 (el nombre accesible contiene el texto visible). */
      }
      <a
        href={enlaceWa}
        target="_blank"
        rel="noopener"
        aria-label={`Consultar por WhatsApp — ${producto.nombre}, Ref. ${producto.codigo}`}
        class="bg-whatsapp flex min-h-10 w-full items-center justify-center gap-2 rounded px-3 py-2 text-center text-sm leading-tight font-medium text-white"
      >
        <IconoWhatsApp tamano={16} />
        Consultar
      </a>
    </div>
  </div>
</li>
