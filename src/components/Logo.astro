---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

/**
 * ============================================================================
 * PARCHE TEMPORAL — quitar cuando llegue el logo definitivo
 * ============================================================================
 *
 * `logo.png` deja margen transparente alrededor del contenido, asi que a una
 * caja de 88 px la medalla se ve a ~80 px. Se compensa escalando.
 *
 * Medido sobre el archivo (SPEC §2.1), tomando la fila mas ancha y la columna
 * mas alta con alpha > 128:
 *
 *   lienzo       500 x 500
 *   bbox opaco   x 50..459 (410 px)   y 41..447 (407 px)
 *   centro       (254.5, 244)
 *
 * El contenido NO esta centrado: cae 4.5 px a la derecha y 6 px arriba del
 * centro del lienzo. Sin corregirlo, la escala lo empuja fuera de la caja por
 * arriba y por la derecha, y se ve cortado. De ahi el translate.
 *
 * LIENZO sale del propio asset y no va hardcodeado: cuando el archivo cambio de
 * 1024 a 500 px, la constante vieja dejo una escala 23 % de mas y recorto el
 * logo. Derivarlo evita que ese error se repita en silencio. Asume asset
 * CUADRADO — con object-contain en caja cuadrada, las fracciones del lienzo
 * coinciden con las del elemento, que es lo que mide el translate en %.
 *
 * PARA DESACTIVARLO: poner MARGEN_SEGURIDAD en 0 (deja ESCALA en 1). Nada mas.
 * Hacerlo en cuanto el logo venga recortado al trazo.
 */
const LIENZO = logo.width;

/** bbox del contenido opaco, medido. */
const BBOX = { x0: 50, x1: 459, y0: 41, y1: 447 };

const ANCHO = BBOX.x1 - BBOX.x0 + 1;
const ALTO = BBOX.y1 - BBOX.y0 + 1;

/**
 * El BBOX esta medido a mano contra un archivo concreto, asi que un reemplazo de
 * logo.png lo invalida. Estas dos guardas convierten ese error en un fallo de
 * build en vez de un logo recortado que hay que cazar mirando. La segunda es la
 * que faltaba: el bbox de 1024 px sobre un lienzo de 500 se pasaba del borde.
 */
if (logo.width !== logo.height) {
  throw new Error(
    `Logo.astro espera un asset cuadrado y logo.png es ${logo.width}x${logo.height}. ` +
      'El translate en % asume que las fracciones del lienzo coinciden con las del elemento.'
  );
}
if (BBOX.x1 >= LIENZO || BBOX.y1 >= LIENZO) {
  throw new Error(
    `El BBOX de Logo.astro (x hasta ${BBOX.x1}, y hasta ${BBOX.y1}) no cabe en el lienzo de ` +
      `${LIENZO} px de logo.png. Volver a medir el bbox opaco y actualizar SPEC §2.1.`
  );
}

/**
 * Holgura del 1.5 %.
 *
 * Ajustado al milimetro el borde caia 0.05 px afuera y se recortaba. En una
 * curva, medio pixel de recorte se lee como un corte plano. No vale la pena
 * pelear el ultimo 1 % de tamano: la ganancia baja de 22 % a 20 %.
 */
const MARGEN_SEGURIDAD = 0.015;

/** Escala limitada por la dimension MAYOR del bbox, no por el promedio. */
const ESCALA = (LIENZO / Math.max(ANCHO, ALTO)) * (1 - MARGEN_SEGURIDAD);

/**
 * Centrado. Se aplica antes del scale (los transforms se leen de derecha a
 * izquierda), asi que el desplazamiento efectivo es este valor por ESCALA.
 */
const AJUSTE_X = ((LIENZO / 2 - (BBOX.x0 + BBOX.x1) / 2) / LIENZO) * 100;
const AJUSTE_Y = ((LIENZO / 2 - (BBOX.y0 + BBOX.y1) / 2) / LIENZO) * 100;

interface Props {
  /** Clases de tamano de la caja. Debe ser cuadrada. */
  class?: string;
  prioridad?: boolean;
}

const { class: clase = 'h-16 w-16 sm:h-22 sm:w-22', prioridad = false } = Astro.props;
---

<span class={`relative block shrink-0 overflow-hidden ${clase}`}>
  {/*
    width/height al doble del render mayor para que quede nitido en 2x.
    alt="" porque el nombre del comercio esta en el wordmark de al lado:
    repetirlo es ruido para el lector de pantalla (SPEC §3.4).
  */}
  <Image
    src={logo}
    width={208}
    height={208}
    alt=""
    loading={prioridad ? 'eager' : 'lazy'}
    class="absolute inset-0 h-full w-full object-contain"
    style={`transform: scale(${ESCALA.toFixed(4)}) translate(${AJUSTE_X.toFixed(3)}%, ${AJUSTE_Y.toFixed(3)}%);`}
  />
</span>
