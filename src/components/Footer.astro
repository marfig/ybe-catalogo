---
import { PUBLIC_WHATSAPP } from 'astro:env/client';
import { normalizarTelefono } from '../lib/whatsapp.ts';
import { COMERCIO, LEYENDA_PRECIO, MARCA, REDES } from '../lib/sitio.ts';

const telefono = normalizarTelefono(PUBLIC_WHATSAPP);
---

<footer class="bg-superficie border-borde mt-8 border-t">
  <div
    class="text-texto-suave mx-auto flex max-w-6xl flex-col gap-3 px-4 py-6 text-sm sm:px-6"
  >
    {/* No repetir "productos Chenson" al lado del nombre del local, que ya lo
        contiene: seria redundante. Se nombra la marca solo si difiere. */}
    <p>
      <strong class="text-texto">{COMERCIO}</strong>
      {!COMERCIO.includes(MARCA) && <> — productos {MARCA}</>}. Consultá por WhatsApp al
      <a class="underline" href={`https://wa.me/${telefono}`}>+{telefono}</a>.
    </p>

    {/* Leyenda obligatoria junto a los precios publicados (SPEC §7.3) */}
    <p>{LEYENDA_PRECIO}.</p>

    {/*
      Navegacion de pie, corta a proposito: dos destinos estables que existen siempre.
      NO se listan las categorias una por una — el footer se repite en TODAS las
      paginas del sitio, y dos docenas de enlaces en cada una es ruido para quien lee y
      enlazado interno diluido para Google. Para eso esta `/categorias`, que las junta
      en un solo destino.
    */}
    <nav aria-label="Secciones">
      <ul class="flex flex-wrap gap-x-4 gap-y-1">
        <li><a class="underline" href="/">Inicio</a></li>
        <li><a class="underline" href="/categorias">Categorías</a></li>
      </ul>
    </nav>

    {
      REDES.length > 0 && (
        <ul class="flex gap-3">
          {REDES.map((url) => (
            <li>
              <a class="underline" href={url}>
                {new URL(url).hostname.replace('www.', '')}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>
